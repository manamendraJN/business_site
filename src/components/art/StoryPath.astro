---
/**
 * Our world: "your new website, delivered to your door".
 * A cut-paper diorama at golden hour, lit from behind by a low sun. One road
 * winds from the viewer to the client's house on the horizon. On scroll, our
 * van drives the road carrying the new website on its roof; when it arrives,
 * the website goes into the house and its windows light up.
 *
 * Drawn to look like real paper photographed in warm evening light:
 *  - atmospheric perspective: each ridge further away is paler and hazier
 *  - backlight: the house, the tree and the grass tips catch the sun,
 *    while the sides facing us fall into soft shade
 *  - the hills meet without outlines: each is told apart by its colour
 *  - long shadows fall toward the viewer
 *  - one static paper-tooth texture over the whole scene
 *
 * Depth layers (one shared 1600 × 1000 box, anchored bottom-right, so the
 * road lines up across layers on any screen shape):
 *   bg      → sky, the sun, its glow and rays, thin clouds   (farthest)
 *   far     → three receding ridges, the house and its tree
 *   mid     → the fields and the road, with long shadows
 *   vehicle → the van, moved along the road by scroll
 *   fg      → dark grasses with sunlit tips                   (nearest)
 */
import Van from "./Van.astro";
import { home } from "@/content/site";
import { seeded } from "@/lib/paper";

const ASPECT = "xMaxYMax slice";

type P = [number, number];
const fmt = (p: P) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
const line = (pts: P[]) => `M${pts.map(fmt).join(" L")}`;
// a paper sheet: its top edge, then straight down to the bottom of the box
const sheet = (pts: P[], bottom = 1000) =>
  `${line(pts)} L${pts[pts.length - 1][0].toFixed(1)} ${bottom} L${pts[0][0].toFixed(1)} ${bottom} Z`;

/**
 * A hand-cut edge through key points:
 *  - a smooth rolling curve through the keys (it keeps its slope through
 *    each key, so the hills flow into each other instead of flattening out)
 *  - uneven waves along it, like a line cut by hand with scissors
 *  - the slight wobble of the blade
 * `calm` is a stretch [x0, x1] kept level (where a house or road sits on it).
 */
function edge(keys: P[], seed: number, wobble = 1.2, step = 8, ripple = 0, calm?: [number, number]): P[] {
  const rand = seeded(seed);
  const n = keys.length;
  // the slope at each key, from its neighbours (Catmull-Rom, as a function of x)
  const slope = keys.map((_, i) => {
    const a = keys[Math.max(0, i - 1)];
    const b = keys[Math.min(n - 1, i + 1)];
    return (b[1] - a[1]) / (b[0] - a[0]);
  });
  const p1 = rand() * Math.PI * 2;
  const p2 = rand() * Math.PI * 2;
  const p3 = rand() * Math.PI * 2;
  const pts: P[] = [];
  for (let i = 0; i < n - 1; i++) {
    const [x0, y0] = keys[i];
    const [x1, y1] = keys[i + 1];
    const h = x1 - x0;
    for (let x = x0; x < x1; x += step) {
      const t = (x - x0) / h;
      const t2 = t * t;
      const t3 = t2 * t;
      const y =
        (2 * t3 - 3 * t2 + 1) * y0 + (t3 - 2 * t2 + t) * h * slope[i] + (-2 * t3 + 3 * t2) * y1 + (t3 - t2) * h * slope[i + 1];
      // quieter near (and fading into) the calm stretch
      let k = 1;
      if (calm) {
        const d = x < calm[0] ? calm[0] - x : x > calm[1] ? x - calm[1] : 0;
        k = Math.min(1, d / 80);
      }
      const waves = ripple * (Math.sin(x / 47 + p1) + 0.55 * Math.sin(x / 19 + p2) + 0.3 * Math.sin(x / 8.5 + p3));
      pts.push([x, y + k * (waves + (rand() - 0.5) * wobble)]);
    }
  }
  pts.push(keys[n - 1]);
  return pts;
}
/**
 * A layer of hills: a hand-cut edge (see edge) with rounded hills rising
 * out of it. Each hill is [centre x, half-width, height]; hills of
 * different sizes overlap, so the outline reads as real rolling country
 * rather than a ruled line.
 */
type Hill = [number, number, number];
function hills(base: P[], domes: Hill[], seed: number, wobble: number, step: number, ripple: number, calm?: [number, number]): P[] {
  return edge(base, seed, wobble, step, ripple, calm).map(([x, y]): P => {
    let lift = 0;
    for (const [c, w, h] of domes) {
      const u = (x - c) / w;
      if (u > -1 && u < 1) lift += (h * (Math.cos(u * Math.PI) + 1)) / 2;
    }
    return [x, y - lift];
  });
}
/** The height of an edge at x (to plant trees and grass on it). */
function heightAt(pts: P[], x: number): number {
  const i = pts.findIndex((p) => p[0] >= x);
  if (i <= 0) return pts[Math.max(0, i)][1];
  const [x0, y0] = pts[i - 1];
  const [x1, y1] = pts[i];
  return y0 + ((x - x0) / (x1 - x0)) * (y1 - y0);
}
/** A leafy lump: a circle with a soft, uneven outline. */
function lump(cx: number, cy: number, r: number, seed: number, lumps = 7, rough = 0.12, squash = 0.92): string {
  const rand = seeded(seed);
  const phase = rand() * Math.PI * 2;
  const pts: P[] = [];
  const n = r > 12 ? 40 : 24;
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2;
    const k = 1 + Math.sin(a * lumps + phase) * rough + (rand() - 0.5) * rough * 0.7;
    pts.push([cx + Math.cos(a) * r * k, cy + Math.sin(a) * r * k * squash]);
  }
  return `${line(pts)} Z`;
}
/* ---- Light: a low sun over the far hills, behind the house ---- */
const SUN = { x: 1112, y: 541, r: 34 };
// faint shafts of light fanning up from the sun
const rays = (
  [
    [196, 7],
    [218, 5],
    [241, 9],
    [266, 6],
    [292, 8],
    [318, 5],
    [338, 7],
  ] as const
).map(([deg, spread]) => {
  const L = 1150;
  const a1 = ((deg - spread / 2) * Math.PI) / 180;
  const a2 = ((deg + spread / 2) * Math.PI) / 180;
  return `M${SUN.x} ${SUN.y} L${fmt([SUN.x + Math.cos(a1) * L, SUN.y + Math.sin(a1) * L])} L${fmt([SUN.x + Math.cos(a2) * L, SUN.y + Math.sin(a2) * L])} Z`;
});
// soft streaks of evening cloud, lit by the sun: [cx, cy, rx, ry]
const clouds: [number, number, number, number][] = [
  [1400, 230, 240, 11],
  [1272, 252, 150, 6],
  [1060, 300, 200, 8],
  [1530, 340, 140, 6],
  [905, 366, 120, 4.5],
];

/* ---- FAR: three receding ridges (the sun sets behind the farthest) ---- */
const R1 = hills(
  [[-40, 516], [600, 520], [1100, 538], [1640, 528]],
  [[150, 250, 34], [560, 190, 22], [860, 290, 46], [1430, 270, 44], [1640, 150, 18]],
  11, 0.8, 8, 0.8,
);
const R2 = hills(
  [[-40, 548], [700, 552], [1150, 566], [1640, 548]],
  [[30, 190, 24], [380, 230, 34], [720, 210, 26], [1480, 230, 30]],
  12, 1, 8, 1,
);
const R3 = hills(
  [[-40, 580], [700, 578], [1180, 590], [1640, 580]],
  [[180, 200, 28], [560, 250, 32], [900, 170, 20], [1580, 150, 18]],
  13, 1.1, 8, 1.2,
);
// distant woods along the nearest ridge: only beside the house and its tree,
// so nothing sits behind the words on the left
const woodsRand = seeded(14);
const woods: string[] = [];
for (const [from, to] of [[1490, 1640]] as const) {
  for (let x = from; x < to; x += 9 + woodsRand() * 14) {
    const r = 4 + woodsRand() * 4.5;
    woods.push(lump(x, heightAt(R3, x) - r * 0.25, r, 100 + Math.round(x), 6, 0.1, 1.1));
  }
}

/* ---- MID: the fields, nearest last ---- */
const F1 = hills(
  [[-40, 624], [600, 626], [1100, 612], [1225, 596], [1330, 589], [1480, 592], [1640, 598]],
  [[110, 200, 30], [430, 240, 38], [770, 200, 24], [1040, 150, 18]],
  21, 0.8, 7, 1.6, [1225, 1500],
);

/* ---- The road: one centre line, sampled into a perspective ribbon ---- */
const curves: [P, P, P, P][] = [
  [[1405, 1000], [1380, 900], [1240, 820], [1270, 740]],
  [[1270, 740], [1285, 700], [1320, 630], [1332, 595]],
];

const bez = ([a, b, c, d]: [P, P, P, P], t: number): P => {
  const u = 1 - t;
  return [
    u * u * u * a[0] + 3 * u * u * t * b[0] + 3 * u * t * t * c[0] + t * t * t * d[0],
    u * u * u * a[1] + 3 * u * u * t * b[1] + 3 * u * t * t * c[1] + t * t * t * d[1],
  ];
};
const STEPS = 28;
const centre: P[] = [
  // the road carries on below the picture, so moving it never shows its end
  [1428, 1090],
  ...curves.flatMap((curve, ci) => Array.from({ length: STEPS + 1 }, (_, i) => bez(curve, i / STEPS)).slice(ci ? 1 : 0)),
];
/* The van keeps its size: full size where it first appears near us, and
 * 0.2 of that when it stops at the house, just in front of the door. Its
 * size falls off evenly with distance, toward one vanishing height, and the
 * road is made wide enough for it at every point (the van is always 41% of
 * the road's width), so it never leaves the road. */
const VAN_START = { y: 985, scale: 1 }; // where the van first appears, near us
const VAN_STOP = { y: 608, scale: 0.2 }; // parked just in front of the door
const VANISH =
  (VAN_START.scale * VAN_STOP.y - VAN_STOP.scale * VAN_START.y) / (VAN_START.scale - VAN_STOP.scale);
const VAN_K = VAN_START.scale / (VAN_START.y - VANISH); // van scale per unit below VANISH
const vanScale = (y: number) => VAN_K * (y - VANISH);
// the road narrows toward the same height, 312 wide at the bottom
const width = (y: number) => (312 * Math.max(0, y - VANISH)) / (1000 - VANISH);
const roadL = centre.map(([x, y]): P => [x - width(y) / 2, y]);
const roadR = centre.map(([x, y]): P => [x + width(y) / 2, y]);
const road = `M${roadL.map(fmt).join(" L")} L${[...roadR].reverse().map(fmt).join(" L")} Z`;
// centre dashes that shrink with distance
const dashes = centre
  .slice(0, -2)
  .map((p, i) => ({ p, q: centre[i + 1], i }))
  .filter(({ i }) => i % 2 === 0)
  .map(({ p, q }) => {
    const hw = Math.max(0.6, width(p[1]) * 0.025);
    const hq = Math.max(0.6, width(q[1]) * 0.025);
    return `M${p[0] - hw} ${p[1]} L${p[0] + hw} ${p[1]} L${q[0] + hq} ${q[1]} L${q[0] - hq} ${q[1]} Z`;
  });

/* ---- The van's drive: placed on the road's centre line, sized as above.
 * scripts/motion/hero.ts reads these numbers from data-drive. */
const DRIVE = {
  horizon: VANISH,
  start: VAN_START.y,
  stop: VAN_STOP.y,
  k: VAN_K,
  road: centre.map(([x, y]) => [Math.round(x * 10) / 10, Math.round(y * 10) / 10]),
};
// the centre of the road at a given height (the road runs steadily up the picture)
const roadX = (y: number) => {
  for (let i = 1; i < centre.length; i++) {
    const [x0, y0] = centre[i - 1];
    const [x1, y1] = centre[i];
    if (y >= y1) return x0 + ((x1 - x0) * (y - y0)) / (y1 - y0);
  }
  return centre[centre.length - 1][0];
};
// without motion the van is already parked at its stop
const vanParked = `translate(${roadX(DRIVE.stop).toFixed(1)} ${DRIVE.stop}) scale(${vanScale(DRIVE.stop).toFixed(3)})`;

/* ---- Things on the ground in front of the house, in perspective ----
 * Bushes, grass clumps and stones, and a row of fence posts along the road.
 * All stand on one ground plane seen by one camera: big near us, smaller,
 * closer together and hazier toward the house (the same vanishing height as
 * the road and the van). The low sun is behind them, so their tops catch the
 * light and their soft shadows fall toward us. */
// how big something is at a given height: 1 at the bottom, smaller with distance
const sizeAt = (y: number) => (y - VANISH) / (1000 - VANISH);
type Thing = { kind: "bush" | "grass" | "stone" | "rock" | "post"; x: number; y: number; k: number; seed: number; size?: number };
const things: Thing[] = [];
const groundRand = seeded(41);
const Z_NEAR = 1 / (1010 - VANISH);
const Z_FAR = 1 / (632 - VANISH);
const clearOf = (x: number, y: number, k: number) => {
  if (y < heightAt(F1, x) + 6) return false; // on the ground, below its skyline
  if (Math.abs(x - roadX(y)) < width(y) / 2 + 16 * k) return false; // off the road
  if (x > 1215 && x < 1395 && y < 660) return false; // not in front of the house's walls
  if (x > 1405 && x < 1505 && y < 650) return false; // nor the tree
  return true;
};
for (let i = 0; i < 4000 && things.length < 120; i++) {
  // even spacing on the ground: deeper rows hold more things on screen
  const z = Z_NEAR + (Z_FAR - Z_NEAR) * groundRand();
  if (groundRand() > 0.3 + 0.7 * (z / Z_FAR)) continue;
  const y = VANISH + 1 / z;
  const x = -40 + groundRand() * 1680;
  const k = sizeAt(y);
  const r = groundRand();
  const kind = r < 0.36 ? "bush" : r < 0.82 ? "grass" : "stone";
  if (!clearOf(x, y, k)) continue;
  things.push({ kind, x, y, k, seed: 500 + i });
}
// rocks: a big one, often with a smaller one or two beside it
const rockRand = seeded(61);
for (let g = 0, tries = 0; g < 13 && tries < 800; tries++) {
  // more groups near us than far away
  const z = Z_NEAR + (Z_FAR - Z_NEAR) * Math.pow(rockRand(), 1.4);
  const y = VANISH + 1 / z;
  const x = -20 + rockRand() * 1640;
  const k = sizeAt(y);
  const big = 0.75 + rockRand() * 0.5;
  const reach = 90 * big * k;
  if (!clearOf(x, y, k) || !clearOf(x - reach, y, k) || !clearOf(x + reach, y, k)) continue;
  things.push({ kind: "rock", x, y, k, seed: 1200 + tries, size: big });
  // smaller neighbours, a little in front or behind
  const extra = Math.floor(rockRand() * 3);
  for (let e = 0; e < extra; e++) {
    const side = rockRand() < 0.5 ? -1 : 1;
    const nx = x + side * (70 + rockRand() * 40) * big * k;
    const ny = y + (rockRand() - 0.4) * 10 * k;
    if (clearOf(nx, ny, k)) things.push({ kind: "rock", x: nx, y: ny, k: sizeAt(ny), seed: 1300 + tries * 4 + e, size: 0.3 + rockRand() * 0.3 });
  }
  g++;
}
// fence posts along the left side of the road, evenly spaced on the ground
for (let i = 0; i < 16; i++) {
  const z = Z_NEAR + ((Z_FAR - Z_NEAR) * i) / 15;
  const y = VANISH + 1 / z;
  const k = sizeAt(y);
  things.push({ kind: "post", x: roadX(y) - width(y) / 2 - 22 * k, y, k, seed: 900 + i });
}
// far things first, so nearer ones stand in front of them
things.sort((a, b) => a.y - b.y);

// how each thing is drawn (shapes in scene units)
const thingShapes = things.map(({ kind, x, y, k, seed, size = 1 }) => {
  const rand = seeded(seed);
  // the shadow falls toward us, and away from the sun on either side
  const dx = (x - SUN.x) * 0.05 * k;
  const haze = Math.min(1, 0.35 + 0.75 * k); // farther things fade into the haze
  if (kind === "post") {
    const h = 40 * k;
    const w = Math.max(1, 5 * k);
    return {
      haze,
      shadow: `M${fmt([x - w, y])} L${fmt([x + w, y])} L${fmt([x + w + dx, y + 9 * k])} L${fmt([x - w + dx, y + 9 * k])} Z`,
      body: [
        { d: `M${fmt([x - w / 2, y])} L${fmt([x - w / 2, y - h])} L${fmt([x + w / 2, y - h - 0.8 * k])} L${fmt([x + w / 2, y])} Z`, fill: "var(--sp-post)" },
        { d: `M${fmt([x - w / 2, y - h])} L${fmt([x + w / 2, y - h - 0.8 * k])} L${fmt([x + w / 2, y - h + 1.6 * k])} L${fmt([x - w / 2, y - h + 2.2 * k])} Z`, fill: "var(--sp-glint)" },
      ],
    };
  }
  if (kind === "bush") {
    const r = (17 + rand() * 15) * k;
    const cy = y - r * 0.55;
    return {
      haze,
      shadow: `M${fmt([x - r, y])} Q${fmt([x + dx * 0.5, y + 12 * k])} ${fmt([x + r + dx, y + 2 * k])} Z`,
      body: [
        // the whole bush in light first, then again in shade a little lower,
        // which leaves a sunlit rim along its top
        { d: lump(x, cy, r, seed, 6, 0.14, 0.78), fill: "var(--sp-bush-lit)" },
        { d: lump(x, cy + Math.max(0.6, 1.6 * k), r * 0.97, seed, 6, 0.14, 0.78), fill: "var(--sp-bush)" },
      ],
    };
  }
  if (kind === "rock") {
    // a faceted rock: the low sun is behind it, so its top catches the light,
    // the side toward the sun is half lit, and the face toward us is in shade
    const rx = (50 + rand() * 34) * size * k;
    const h = rx * (0.78 + rand() * 0.32);
    const sunSide = x < SUN.x ? 1 : -1;
    // the outline: corners along an uneven dome, the bottom sunk into the ground
    const n = 7;
    const top: P[] = Array.from({ length: n }, (_, i) => {
      const a = Math.PI + (i / (n - 1)) * Math.PI; // left, over the top, to the right
      const j = 0.82 + rand() * 0.3;
      return [x + Math.cos(a) * rx * (0.92 + rand() * 0.12), y + Math.sin(a) * h * j];
    });
    top[0] = [x - rx, y + 1.5 * k];
    top[n - 1] = [x + rx, y + 1.5 * k];
    const peak = top.reduce((m, p) => (p[1] < m[1] ? p : m), top[0]);
    const poly = (pts: P[]) => `M${pts.map(fmt).join(" L")} Z`;
    const body = poly([...top, [x + rx * 0.85, y + 3 * k], [x - rx * 0.85, y + 3 * k]]);
    // the side facing the sun: from the peak down to the base on that side
    const sideEnd = sunSide > 0 ? top[n - 1] : top[0];
    const inner: P = [peak[0] - sunSide * rx * 0.12, y - h * 0.18];
    const sideFacet = poly(
      sunSide > 0
        ? [peak, ...top.slice(top.indexOf(peak) + 1), [sideEnd[0] - rx * 0.1, y + 2 * k], inner]
        : [...top.slice(0, top.indexOf(peak) + 1), inner, [sideEnd[0] + rx * 0.1, y + 2 * k]],
    );
    // the top: the upper corners and the same corners a little lower
    const upper = top.slice(1, n - 1);
    const topFacet = poly([...upper, ...upper.map(([px, py]): P => [x + (px - x) * 0.82, py + h * 0.24]).reverse()]);
    return {
      haze,
      shadow: `M${fmt([x - rx * 1.05, y + 1 * k])} Q${fmt([x + dx * 0.6, y + 16 * k * size])} ${fmt([x + rx * 1.1 + dx, y + 3 * k])} Z`,
      body: [
        { d: body, fill: "var(--sp-rock)" },
        { d: sideFacet, fill: "var(--sp-rock-mid)" },
        { d: topFacet, fill: "var(--sp-rock-lit)" },
        // a soft dark line where the rock meets the ground
        { d: `M${fmt([x - rx * 0.9, y + 3 * k])} Q${fmt([x, y + 6 * k])} ${fmt([x + rx * 0.9, y + 3 * k])} Q${fmt([x, y + 1 * k])} ${fmt([x - rx * 0.9, y + 3 * k])} Z`, fill: "var(--sp-rock-foot)" },
      ],
    };
  }
  if (kind === "stone") {
    const rx = (9 + rand() * 9) * k;
    const ry = rx * 0.5;
    return {
      haze,
      shadow: `M${fmt([x - rx, y])} Q${fmt([x + dx * 0.5, y + 8 * k])} ${fmt([x + rx + dx, y + 1 * k])} Z`,
      body: [
        { d: `M${fmt([x - rx, y])} Q${fmt([x - rx, y - ry * 1.6])} ${fmt([x, y - ry * 1.7])} Q${fmt([x + rx, y - ry * 1.6])} ${fmt([x + rx, y])} Z`, fill: "var(--sp-stone)" },
        { d: `M${fmt([x - rx * 0.7, y - ry * 1.1])} Q${fmt([x, y - ry * 1.75])} ${fmt([x + rx * 0.7, y - ry * 1.1])} Q${fmt([x, y - ry * 1.4])} ${fmt([x - rx * 0.7, y - ry * 1.1])} Z`, fill: "var(--sp-stone-lit)" },
      ],
    };
  }
  // a clump of grass: a few blades fanning out, their tips lit by the sun
  const blades = 4 + Math.floor(rand() * 4);
  const h = (30 + rand() * 26) * k;
  const parts: { d: string; fill: string }[] = [];
  for (let b = 0; b < blades; b++) {
    const lean = (b / (blades - 1) - 0.5) * 1.3 + (rand() - 0.5) * 0.4;
    const bh = h * (0.7 + rand() * 0.45);
    const bw = Math.max(0.5, 2.2 * k);
    const bx = x + (b - blades / 2) * 2.4 * k;
    const tip: P = [bx + lean * bh * 0.55, y - bh];
    const mid: P = [bx + lean * bh * 0.15, y - bh * 0.6];
    parts.push({ d: `M${fmt([bx - bw, y])} Q${fmt(mid)} ${fmt(tip)} Q${fmt([mid[0] + bw, mid[1]])} ${fmt([bx + bw, y])} Z`, fill: "var(--sp-tuft)" });
  }
  return {
    haze,
    shadow: `M${fmt([x - 6 * k, y])} Q${fmt([x + dx * 0.5, y + 7 * k])} ${fmt([x + 6 * k + dx, y + 1 * k])} Z`,
    body: parts,
  };
});

/* ---- FG: dark grasses, their tips lit by the sun behind them ---- */
const moundL = edge([[-40, 918], [120, 896], [330, 918], [520, 952], [700, 992], [820, 1012]], 31, 2.4, 6);
const moundR = edge([[1460, 1012], [1530, 972], [1600, 950], [1640, 944]], 32, 2.4, 6);
/** One blade of grass growing from the ground at x, with its sunlit edge. */
function grassBlade(x: number, h: number, ground: number, rand: () => number) {
  const bend = (rand() - 0.55) * h * 0.45;
  const w = 2.4 + rand() * 3.2;
  const base = ground + 14;
  const tip: P = [x + bend, ground - h * 0.55];
  const mid: P = [x + bend * 0.35, base - (base - tip[1]) * 0.6];
  const start: P = [x - w / 2, base];
  // the upper half of the blade's left edge (the same curve, from t = 0.5)
  const half: P = [0.25 * start[0] + 0.5 * mid[0] + 0.25 * tip[0], 0.25 * start[1] + 0.5 * mid[1] + 0.25 * tip[1]];
  const halfCtrl: P = [(mid[0] + tip[0]) / 2, (mid[1] + tip[1]) / 2];
  return {
    blade: `M${fmt(start)} Q${fmt(mid)} ${fmt(tip)} Q${fmt([mid[0] + w * 0.4, mid[1]])} ${x + w / 2} ${base} Z`,
    glint: `M${fmt(half)} Q${fmt(halfCtrl)} ${fmt(tip)}`,
  };
}
/** A tall seed head on its stem, growing from the ground at x. */
function seedHead(x: number, h: number, lean: number, ground: number) {
  const tip: P = [x + lean, ground - h];
  const ctrl: P = [x + lean * 0.15, ground - h * 0.6];
  const angle = (Math.atan2(tip[1] - ctrl[1], tip[0] - ctrl[0]) * 180) / Math.PI + 90;
  return { stem: `M${x} ${ground + 10} Q${fmt(ctrl)} ${fmt(tip)}`, tip, angle };
}
const groundAt = (x: number) => (x < 900 ? heightAt(moundL, x) : heightAt(moundR, x));
const grassRand = seeded(33);
const blades = [
  ...Array.from({ length: 30 }, () => ({ x: grassRand() * 520, h: 70 + grassRand() * 150 })),
  ...Array.from({ length: 12 }, () => ({ x: 1520 + grassRand() * 90, h: 60 + grassRand() * 120 })),
].map(({ x, h }) => grassBlade(x, h, groundAt(x), grassRand));
// a few tall seed heads
const seedHeads = [
  { x: 70, h: 190, lean: 26 },
  { x: 168, h: 240, lean: 34 },
  { x: 236, h: 205, lean: 18 },
  { x: 352, h: 168, lean: 30 },
  { x: 1574, h: 176, lean: -22 },
].map(({ x, h, lean }) => seedHead(x, h, lean, groundAt(x)));

/* Narrow screens (phones, portrait tablets) show only the right part of the
 * scene, where the dark land above is out of view. There, the same dark land
 * and grass rise in the bottom-left corner of what is shown, sloping down to
 * the edge of the road so they never cover the van. */
const moundN = edge([[800, 878], [930, 866], [1040, 888], [1130, 932], [1200, 978], [1252, 1016]], 34, 2.4, 6);
const narrowRand = seeded(35);
const bladesN = Array.from({ length: 20 }, () => ({ x: 830 + narrowRand() * 360, h: 50 + narrowRand() * 110 })).map(({ x, h }) =>
  grassBlade(x, h, heightAt(moundN, x), narrowRand),
);
const seedHeadsN = [
  { x: 952, h: 170, lean: 22 },
  { x: 1030, h: 140, lean: 28 },
  { x: 1098, h: 118, lean: 16 },
].map(({ x, h, lean }) => seedHead(x, h, lean, heightAt(moundN, x)));

// the tree's front clumps: [cx, cy, r, seed]
const crown: [number, number, number, number][] = [
  [1441, 517, 18, 53],
  [1465, 513, 19, 54],
  [1452, 496, 17, 55],
  [1447, 534, 14, 56],
  [1464, 533, 13, 57],
];

const delivered = home.turn.delivered;
const labelW = 30 + delivered.length * 8.6;
---
<div class="story-path absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- BG: sky, the low sun and its glow -->
  <div class="layer" data-layer="bg">
    <div data-depth="0" class="sky h-full w-full">
      <svg viewBox="0 0 1600 1000" preserveAspectRatio={ASPECT}>
        <defs>
          <radialGradient id="sp-bloom" gradientUnits="userSpaceOnUse" cx={SUN.x} cy={SUN.y} r="720">
            <stop offset="0" stop-color="var(--sp-sun)" stop-opacity="1" />
            <stop offset="0.07" stop-color="var(--sp-sun)" stop-opacity="0.9" />
            <stop offset="0.2" stop-color="var(--sp-sun-glow)" stop-opacity="0.55" />
            <stop offset="0.45" stop-color="var(--sp-sky-glow)" stop-opacity="0.2" />
            <stop offset="1" stop-color="var(--sp-sky-glow)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sp-horizon" gradientUnits="userSpaceOnUse" cx={SUN.x} cy="556" r="1000" gradientTransform={`translate(${SUN.x} 556) scale(1 0.11) translate(${-SUN.x} -556)`}>
            <stop offset="0" stop-color="var(--sp-sun)" stop-opacity="0.75" />
            <stop offset="1" stop-color="var(--sp-sun-glow)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sp-ray" gradientUnits="userSpaceOnUse" cx={SUN.x} cy={SUN.y} r="1150">
            <stop offset="0" stop-color="var(--sp-sun)" stop-opacity="0.24" />
            <stop offset="0.5" stop-color="var(--sp-sun)" stop-opacity="0.06" />
            <stop offset="1" stop-color="var(--sp-sun)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="sp-cloud" cx="0.5" cy="0.62" r="0.5">
            <stop offset="0" stop-color="var(--sp-cloud-lit)" stop-opacity="0.95" />
            <stop offset="0.55" stop-color="var(--sp-cloud-top)" stop-opacity="0.55" />
            <stop offset="1" stop-color="var(--sp-cloud-top)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect x="-200" y="0" width="2000" height="1000" fill="url(#sp-bloom)" />
        {rays.map((d) => <path d={d} fill="url(#sp-ray)" />)}
        <rect x="-200" y="400" width="2000" height="300" fill="url(#sp-horizon)" />
        <!-- thin streaks of cloud, lit from below -->
        {clouds.map(([cx, cy, rx, ry]) => <ellipse cx={cx} cy={cy} rx={rx} ry={ry} fill="url(#sp-cloud)" />)}
        <!-- the sun: a soft corona and a bright disc -->
        <circle cx={SUN.x} cy={SUN.y} r={SUN.r + 16} fill="var(--sp-sun-glow)" opacity="0.45" />
        <circle cx={SUN.x} cy={SUN.y} r={SUN.r} fill="var(--sp-sun)" />
      </svg>
    </div>
  </div>

  <!-- FAR: three receding ridges, the client's house and its tree -->
  <div class="layer" data-layer="far">
    <div data-depth="0.18">
      <svg viewBox="0 0 1600 1000" preserveAspectRatio={ASPECT}>
        <defs>
          <linearGradient id="sp-r1" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sp-r1)" /><stop offset="0.25" stop-color="var(--sp-r1-haze)" />
          </linearGradient>
          <linearGradient id="sp-r2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sp-r2)" /><stop offset="0.22" stop-color="var(--sp-r2-haze)" />
          </linearGradient>
          <linearGradient id="sp-r3" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sp-r3)" /><stop offset="0.2" stop-color="var(--sp-r3-haze)" />
          </linearGradient>
          <linearGradient id="sp-facade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sp-facade-top)" /><stop offset="1" stop-color="var(--sp-facade)" />
          </linearGradient>
          <linearGradient id="sp-side" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--sp-side-lit)" /><stop offset="1" stop-color="var(--sp-side)" />
          </linearGradient>
          <linearGradient id="sp-roof" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--sp-roof-lit)" /><stop offset="1" stop-color="var(--sp-roof)" />
          </linearGradient>
          <radialGradient id="sp-window-glow" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="var(--sp-lamp)" stop-opacity="0.95" />
            <stop offset="0.35" stop-color="var(--sp-lamp)" stop-opacity="0.4" />
            <stop offset="1" stop-color="var(--sp-lamp)" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="sp-lit-window" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sp-lamp)" /><stop offset="1" stop-color="var(--color-marigold)" />
          </linearGradient>
        </defs>

        <!-- the distant hills, layer behind layer: the farthest palest, each
             nearer one a shade deeper (no outlines: the colours tell them apart) -->
        <path d={sheet(R1, 760)} fill="url(#sp-r1)" />
        <path d={sheet(R2, 760)} fill="url(#sp-r2)" />
        <path d={sheet(R3, 760)} fill="url(#sp-r3)" />
        {woods.map((d) => <path d={d} fill="var(--sp-woods)" />)}

      </svg>
    </div>
  </div>

  <!-- MID: the fields and the road -->
  <div class="layer" data-layer="mid">
    <div data-depth="0.4">
      <svg viewBox="0 0 1600 1000" preserveAspectRatio={ASPECT}>
        <defs>
          <!-- the ground in front of the house: one surface, its colour deepening
               smoothly from the house down to us -->
          <linearGradient id="sp-ground" gradientUnits="userSpaceOnUse" x1="0" y1="585" x2="0" y2="1000">
            <stop offset="0" stop-color="var(--sp-ground-1)" />
            <stop offset="0.14" stop-color="var(--sp-ground-2)" />
            <stop offset="0.38" stop-color="var(--sp-ground-3)" />
            <stop offset="0.62" stop-color="var(--sp-ground-4)" />
            <stop offset="0.84" stop-color="var(--sp-ground-5)" />
            <stop offset="1" stop-color="var(--sp-ground-6)" />
          </linearGradient>
          <linearGradient id="sp-road" gradientUnits="userSpaceOnUse" x1="0" y1="592" x2="0" y2="1000">
            <stop offset="0" stop-color="var(--sp-road-far)" /><stop offset="1" stop-color="var(--sp-road)" />
          </linearGradient>
          <!-- long shadows, fading with distance from what casts them -->
          <linearGradient id="sp-long-shadow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--color-ink)" stop-opacity="0.3" /><stop offset="1" stop-color="var(--color-ink)" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- the ground in front of the house: one surface, no layers, no lines -->
        <path d={sheet(F1, 1090)} fill="url(#sp-ground)" />

        <!-- the road -->
        <path d={road} fill="url(#sp-road)" />
        {dashes.map((d) => <path d={d} fill="var(--sp-dash)" />)}

        <!-- long shadows of the house and the tree, falling toward us -->
        <path d="M1238 591 L1372 594.5 L1446 628 L1296 630 Z" fill="url(#sp-long-shadow)" />
        <path d="M1446 596 L1459 596 L1528 634 L1514 636 Z" fill="url(#sp-long-shadow)" />

        <!-- bushes, grass, stones and fence posts on the ground, in perspective -->
        <g class="sp-things">
          {thingShapes.map(({ haze, shadow, body }) => (
            <g opacity={haze.toFixed(2)}>
              <path d={shadow} fill="var(--color-ink)" opacity="0.22" />
              {body.map(({ d, fill }) => <path d={d} fill={fill} />)}
            </g>
          ))}
        </g>

        <!-- the client's house, seen from the front-left; the sun is behind it,
             so the side facing us is in soft shade and the left wall is lit -->
        <g class="sp-house">
          <ellipse cx="1306" cy="594" rx="86" ry="4" fill="var(--color-ink)" opacity="0.25" />
          <!-- left wall, catching the sun -->
          <path d="M1240 552 L1292 557 L1292 594 L1240 590 Z" fill="url(#sp-side)" />
          <path d="M1255 565 L1272 566.6 L1272 579 L1255 577.4 Z" fill="var(--sp-glass)" />
          <path d="M1255 565 L1272 566.6" stroke="var(--sp-sun-glow)" stroke-width="1" opacity="0.8" />
          <!-- roof, with a chimney -->
          <path d="M1332 515 L1282 510 L1233 553.5 L1287 559.5 Z" fill="url(#sp-roof)" />
          <path d="M1296 527 L1296 501 L1306 502 L1306 520 Z" fill="var(--sp-roof)" />
          <path d="M1296 501 L1306 502" stroke="var(--sp-sun)" stroke-width="1.4" />
          <path d="M1282 510 L1332 515" stroke="var(--sp-sun)" stroke-width="1.5" opacity="0.9" />
          <path d="M1233 553.5 L1287 559.5" stroke="var(--sp-roof-edge)" stroke-width="2" />
          <!-- the gable end, facing us -->
          <path d="M1292 557 L1332 519 L1372 557 L1372 594 L1292 594 Z" fill="url(#sp-facade)" />
          <path d="M1286 561 L1332 516 L1378 561" fill="none" stroke="var(--sp-roof)" stroke-width="5" stroke-linejoin="miter" />
          <path d="M1286 559.4 L1332 514.4" stroke="var(--sp-sun-glow)" stroke-width="1.2" opacity="0.9" />
          <!-- door -->
          <path d="M1324 594 V581 A8 8 0 0 1 1340 581 V594 Z" fill="var(--sp-door)" />
          <!-- windows: dark until the website arrives -->
          <rect x="1299" y="566" width="17" height="14" rx="1.5" fill="var(--sp-glass)" />
          <rect x="1348" y="566" width="17" height="14" rx="1.5" fill="var(--sp-glass)" />
          <g data-house-glow>
            <rect x="1299" y="566" width="17" height="14" rx="1.5" fill="url(#sp-lit-window)" />
            <rect x="1348" y="566" width="17" height="14" rx="1.5" fill="url(#sp-lit-window)" />
            <!-- the new website, on a screen inside -->
            <rect x="1350" y="568" width="13" height="2.6" fill="var(--color-clay)" />
            <rect x="1350" y="572" width="8" height="1.6" fill="var(--color-ink)" />
            <rect x="1350" y="575" width="11" height="1.6" fill="var(--color-ink-soft)" />
            <path d="M1324 594 V581 A8 8 0 0 1 1340 581 V594 Z" fill="var(--color-marigold)" opacity="0.55" />
          </g>
          <!-- window frames -->
          <path d="M1307.5 566 V580 M1299 573 H1316 M1356.5 566 V580" stroke="var(--sp-facade)" stroke-width="1" />
          <!-- warm light spilling from the windows -->
          <circle data-house-glow cx="1332" cy="574" r="64" fill="url(#sp-window-glow)" opacity="0.5" />
        </g>

        <!-- a tree to the right of the house, backlit: dark leaves, bright edges -->
        <g class="sp-tree">
          <ellipse cx="1452" cy="595" rx="22" ry="3" fill="var(--color-ink)" opacity="0.25" />
          <path d="M1447 596 C1449 576 1450 556 1449 534 L1456 534 C1455 556 1456 576 1459 596 Z" fill="var(--sp-trunk)" />
          <path d="M1451 556 C1445 548 1439 543 1432 540" fill="none" stroke="var(--sp-trunk)" stroke-width="3.2" stroke-linecap="round" />
          <path d="M1455 548 C1461 541 1467 537 1474 535" fill="none" stroke="var(--sp-trunk)" stroke-width="2.8" stroke-linecap="round" />
          <path d={lump(1431, 529, 17, 51)} fill="var(--color-moss-deep)" />
          <path d={lump(1475, 526, 18, 52)} fill="var(--color-moss-deep)" />
          <!-- front clumps: the whole crown in sunlight, then again in shade nudged
               away from the sun, which leaves a bright rim only on the sun side -->
          {crown.map(([cx, cy, r, s]) => <path d={lump(cx, cy, r, s)} fill="var(--sp-leaf-lit)" />)}
          {crown.map(([cx, cy, r, s]) => <path d={lump(cx + 2.2, cy + 1, r - 0.4, s)} fill="var(--sp-leaf)" />)}
          <!-- a little depth inside the crown -->
          {crown.slice(3).map(([cx, cy, r, s]) => <path d={lump(cx + 3, cy + 3, r * 0.7, s + 9)} fill="var(--color-moss-deep)" opacity="0.55" />)}
        </g>

        <g data-delivered transform="translate(1332 488)">
          <rect x={-labelW / 2} y="-30" width={labelW} height="30" rx="15" fill="var(--color-ink)" />
          <path d="M-7 0 L0 9 L7 0 Z" fill="var(--color-ink)" />
          <text x="0" y="-10" text-anchor="middle" class="label-text">{delivered}</text>
        </g>
      </svg>
    </div>
  </div>

  <!-- VEHICLE: the van. Without motion it is already parked at the house. -->
  <div class="layer" data-layer="vehicle">
    <div data-depth="0.4">
      <svg viewBox="0 0 1600 1000" preserveAspectRatio={ASPECT}>
        <g data-van-home transform={vanParked} data-drive={JSON.stringify(DRIVE)}>
          <g data-van>
            <Van />
          </g>
        </g>
      </svg>
    </div>
  </div>

  <!-- FG: the dark land nearest to us, with grasses whose tips catch the sun -->
  <div class="layer" data-layer="fg">
    <div data-depth="0.8">
      <svg viewBox="0 0 1600 1000" preserveAspectRatio={ASPECT}>
        <path d={sheet(moundL, 1090)} fill="var(--sp-near)" />
        <path d={sheet(moundR, 1090)} fill="var(--sp-near)" />
        {seedHeads.map(({ stem }) => <path d={stem} fill="none" stroke="var(--sp-near)" stroke-width="2" stroke-linecap="round" />)}
        {seedHeads.map(({ tip, angle }) => (
          <g transform={`translate(${fmt(tip)}) rotate(${angle.toFixed(1)})`}>
            <ellipse cx="0" cy="8" rx="4.2" ry="12" fill="var(--sp-near)" />
            <path d="M-4 12 Q-4.6 2 0 -4" fill="none" stroke="var(--sp-glint)" stroke-width="1.2" opacity="0.85" />
          </g>
        ))}
        {blades.map(({ blade }) => <path d={blade} fill="var(--sp-near)" />)}
        {blades.map(({ glint }) => <path d={glint} fill="none" stroke="var(--sp-glint)" stroke-width="1" stroke-linecap="round" opacity="0.75" />)}
        <!-- narrow screens: the dark land in the bottom-left corner of what is shown -->
        <g class="sp-near-narrow">
          <path d={sheet(moundN, 1090)} fill="var(--sp-near)" />
          {seedHeadsN.map(({ stem }) => <path d={stem} fill="none" stroke="var(--sp-near)" stroke-width="2" stroke-linecap="round" />)}
          {seedHeadsN.map(({ tip, angle }) => (
            <g transform={`translate(${fmt(tip)}) rotate(${angle.toFixed(1)})`}>
              <ellipse cx="0" cy="8" rx="4.2" ry="12" fill="var(--sp-near)" />
              <path d="M-4 12 Q-4.6 2 0 -4" fill="none" stroke="var(--sp-glint)" stroke-width="1.2" opacity="0.85" />
            </g>
          ))}
          {bladesN.map(({ blade }) => <path d={blade} fill="var(--sp-near)" />)}
          {bladesN.map(({ glint }) => <path d={glint} fill="none" stroke="var(--sp-glint)" stroke-width="1" stroke-linecap="round" opacity="0.75" />)}
        </g>
      </svg>
    </div>
  </div>

  <!-- the tooth of the paper over the whole scene (one static texture) -->
  <div class="sp-paper" aria-hidden="true"></div>
</div>

<style>
  /* The scene's own palette: golden hour, with haze in the distance */
  .story-path {
    --sp-sky-top: #ede0cc;
    --sp-sky-mid: #f3d8b3;
    --sp-sky-low: #f7cd99;
    --sp-sky-glow: #f9c98a;
    --sp-sun: #fff7e4;
    --sp-sun-glow: #ffe3a8;
    --sp-cloud-top: #fbe9d2;
    --sp-cloud-lit: #fff3dc;

    --sp-r1: #efc4a2;
    --sp-r1-haze: #f4d3ae;
    --sp-r2: #e2a98a;
    --sp-r2-haze: #edc09e;
    --sp-r3: #d18f73;
    --sp-r3-haze: #e2ad8d;
    --sp-woods: #c78a6f;

    --sp-facade-top: #ecd3b0;
    --sp-facade: #d8b38c;
    --sp-side-lit: #fbe4be;
    --sp-side: #f0cfa2;
    --sp-roof-lit: #b54e2b;
    --sp-roof: #86351d;
    --sp-roof-edge: #6f2a16;
    --sp-door: #7a2d16;
    --sp-glass: #5b4a42;
    --sp-lamp: #ffd77e;
    --sp-trunk: #3f2d22;
    --sp-leaf: #4d5a2b;
    --sp-leaf-lit: #d9c56e;

    /* the ground in front of the house, from the house down to us */
    --sp-ground-1: #ebb68a;
    --sp-ground-2: #e0a06f;
    --sp-ground-3: #d38d58;
    --sp-ground-4: #bf7144;
    --sp-ground-5: #9e512e;
    --sp-ground-6: #7a3620;
    /* things on the ground in front of the house */
    --sp-bush: #6e5432;
    --sp-bush-lit: #d6a95e;
    --sp-tuft: #5e4327;
    --sp-stone: #8c6a52;
    --sp-stone-lit: #e2bb8c;
    --sp-rock: #6a4636;
    --sp-rock-mid: #93694f;
    --sp-rock-lit: #d8aa80;
    --sp-rock-foot: #3a251b;
    --sp-post: #4a3424;
    --sp-road-far: #fdebcd;
    --sp-road: #ecc89c;
    --sp-dash: #dc9c74;

    --sp-near: #2a1f19;
    --sp-glint: #f6c66f;
  }
  .sky {
    background: linear-gradient(
      180deg,
      var(--sp-sky-top) 0%,
      var(--sp-sky-mid) 34%,
      var(--sp-sky-low) 54%,
      var(--sp-sky-glow) 100%
    );
  }

  /* In the still version the website is already delivered: the roof is empty. */
  :global(html:not(.motion)) .story-path :global([data-parcel]) { display: none; }
  .label-text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: var(--color-paper);
  }
  .sp-paper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--texture-paper);
    background-size: 260px 260px;
    opacity: 0.32;
  }
  /* Phones: draw the landscape a little shorter so more of its width fits,
     keeping the road, the van and the house on screen. */
  .story-path :global(.layer) svg { position: absolute; left: 0; bottom: 0; overflow: visible; }
  /* each depth layer is its own picture for the browser: moving it is cheap */
  .story-path :global([data-depth]) { will-change: transform; }
  @media (max-width: 767px) {
    .story-path :global(.layer) svg { height: 78%; }
  }
  /* the dark land for narrow screens: only where the main one is out of view */
  .sp-near-narrow { display: none; }
  @media (max-width: 767px), (max-aspect-ratio: 5/4) {
    .sp-near-narrow { display: inline; }
  }
</style>
