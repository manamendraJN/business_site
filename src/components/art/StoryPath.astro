      var(--sp-sky-low) 54%,
      var(--sp-sky-glow) 100%
    );
  }
  /* soft shadows: wide, faint strokes stacked so they fade out like a blur */
  .sp-shadow :global(path) { fill: none; stroke: var(--color-ink); stroke-opacity: 0.045; stroke-linejoin: round; }

  /* In the still version the website is already delivered: the roof is empty. */
  :global(html:not(.motion)) .story-path :global([data-parcel]) { display: none; }
  .label-text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: var(--color-paper);
  }
  .sp-paper {
