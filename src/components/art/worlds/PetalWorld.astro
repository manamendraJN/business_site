---
/** Petal & Stem (florist): blush wall, arched window, a vase of tall stems, drifting petals. */
const flowers = [
  { x: 330, y: 170, c: "var(--color-rose)", r: 34 },
  { x: 420, y: 130, c: "var(--color-clay)", r: 30 },
  { x: 500, y: 190, c: "var(--color-marigold)", r: 32 },
  { x: 380, y: 240, c: "var(--color-blush)", r: 26 },
  { x: 460, y: 250, c: "var(--color-rose)", r: 24 },
];
const angles = [0, 60, 120, 180, 240, 300];
const drift = [
  { x: 120, y: 120, r: 20 },
  { x: 680, y: 160, r: 70 },
  { x: 610, y: 420, r: 140 },
  { x: 90, y: 400, r: 110 },
  { x: 250, y: 540, r: 40 },
  { x: 720, y: 540, r: 10 },
];
---
<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="layer" data-layer="bg"><div data-depth="0.08">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <rect width="800" height="600" fill="var(--color-blush)" />
      <rect y="470" width="800" height="130" fill="var(--color-paper-deep)" />
    </svg>
  </div></div>
  <div class="layer layer-far" data-layer="far"><div data-depth="0.22">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <path d="M260 470V200a140 140 0 0 1 280 0v270z" fill="var(--color-paper)" />
      <path d="M284 470V206a116 116 0 0 1 232 0v264z" fill="var(--color-dawn)" />
      <rect x="396" y="90" width="8" height="380" fill="var(--color-paper)" />
      <rect x="284" y="300" width="232" height="8" fill="var(--color-paper)" />
    </svg>
  </div></div>
  <div class="layer layer-mid" data-layer="mid"><div data-depth="0.45">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <g class="anim-sway">
        {flowers.map((f) => (
          <path d={`M400 420 Q ${(400 + f.x) / 2} ${(420 + f.y) / 2 + 40} ${f.x} ${f.y}`} stroke="var(--color-moss-deep)" stroke-width="7" fill="none" stroke-linecap="round" />
        ))}
        <path d="M392 330c-50-10-70-40-70-60 30 10 60 30 70 60z" fill="var(--color-moss)" />
        <path d="M410 300c40-20 70-20 90-10-30 20-60 20-90 10z" fill="var(--color-moss)" />
        {flowers.map((f) => (
          <g>
            {angles.map((a) => (
              <ellipse cx={f.x} cy={f.y - f.r * 0.6} rx={f.r * 0.42} ry={f.r * 0.62} fill={f.c} transform={`rotate(${a} ${f.x} ${f.y})`} />
            ))}
            <circle cx={f.x} cy={f.y} r={f.r * 0.32} fill="var(--color-marigold-soft)" />
          </g>
        ))}
      </g>
      <path d="M340 400h120l-14 130a20 20 0 0 1-20 18h-52a20 20 0 0 1-20-18z" fill="var(--color-sea)" />
      <rect x="336" y="396" width="128" height="18" rx="6" fill="var(--color-sea-deep)" />
    </svg>
  </div></div>
  <div class="layer layer-near" data-layer="near"><div data-depth="0.75">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <path d="M-20 620C10 500 80 430 180 400 130 480 90 560 40 620Z" fill="var(--color-moss)" />
      <path d="M820 620C800 520 740 460 650 440 690 510 720 570 760 620Z" fill="var(--color-moss-deep)" />
      <path d="M560 600c30-30 80-30 110-10" stroke="var(--color-rose)" stroke-width="10" fill="none" stroke-linecap="round" />
    </svg>
  </div></div>
  <div class="layer" data-layer="fg"><div data-depth="1.1">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      {drift.map((p, i) => (
        <ellipse cx={p.x} cy={p.y} rx="16" ry="9" fill={i % 2 ? "var(--color-rose)" : "var(--color-clay)"} transform={`rotate(${p.r} ${p.x} ${p.y})`} />
      ))}
    </svg>
  </div></div>
</div>
