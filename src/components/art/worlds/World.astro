---
/** Picks the right paper world for a project. */
import KopiWorld from "./KopiWorld.astro";
import PetalWorld from "./PetalWorld.astro";
import LoomWorld from "./LoomWorld.astro";
import type { Project } from "@/content/site";

interface Props {
  world: Project["world"];
}
const { world } = Astro.props;
---
{world === "kopi" && <KopiWorld />}
{world === "petal" && <PetalWorld />}
{world === "loom" && <LoomWorld />}
