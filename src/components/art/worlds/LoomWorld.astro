---
/** Loom & Linen (clothing): linen wall, shelves of folded cloth, a wooden handloom weaving striped cloth, an indigo shirt on a hanger, a spool and a loose thread. */
const warp = Array.from({ length: 21 }, (_, i) => 150 + i * 12);
// woven rows below the beater: stripes of indigo, linen and madder
const rows = [
  { y: 352, h: 10, c: "var(--color-paper)" },
  { y: 362, h: 14, c: "var(--color-sea-deep)" },
  { y: 376, h: 6, c: "var(--color-paper)" },
  { y: 382, h: 8, c: "var(--color-clay-deep)" },
  { y: 390, h: 6, c: "var(--color-paper)" },
  { y: 396, h: 22, c: "var(--color-sea-deep)" },
  { y: 418, h: 8, c: "var(--color-marigold)" },
  { y: 426, h: 30, c: "var(--color-paper)" },
];
const stacks = [
  { x: 488, y: 112, c: ["var(--color-sea-deep)", "var(--color-paper)", "var(--color-clay-deep)"] },
  { x: 586, y: 112, c: ["var(--color-marigold)", "var(--color-sea)", "var(--color-paper)"] },
  { x: 684, y: 112, c: ["var(--color-clay)", "var(--color-paper-deep)", "var(--color-sea-deep)"] },
];
---
<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="layer" data-layer="bg"><div data-depth="0.08">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <rect width="800" height="600" fill="var(--color-paper-deep)" />
      <!-- soft window light falling across the wall -->
      <path d="M90 0h190L520 600H330z" fill="var(--color-paper)" opacity="0.55" />
      <rect y="480" width="800" height="120" fill="var(--color-paper-shade)" />
    </svg>
  </div></div>
  <div class="layer layer-far" data-layer="far"><div data-depth="0.22">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <!-- shelves of folded cloth -->
      <rect x="470" y="150" width="310" height="9" rx="2" fill="var(--color-paper-shade)" />
      <rect x="470" y="262" width="310" height="9" rx="2" fill="var(--color-paper-shade)" />
      {stacks.map((s) => (
        <g>
          {s.c.map((c, j) => (
            <rect x={s.x} y={s.y + j * 12.5} width="80" height="12" rx="5" fill={c} />
          ))}
        </g>
      ))}
      {stacks.map((s, i) => (
        <g>
          {[...s.c].reverse().map((c, j) => (
            <rect x={s.x + (i - 1) * 4} y={224 + j * 12.5} width="80" height="12" rx="5" fill={c} opacity="0.9" />
          ))}
        </g>
      ))}
    </svg>
  </div></div>
  <div class="layer layer-mid" data-layer="mid"><div data-depth="0.45">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <!-- the handloom -->
      <ellipse cx="270" cy="508" rx="190" ry="14" fill="var(--color-ink)" opacity="0.12" />
      <rect x="112" y="96" width="16" height="410" rx="4" fill="var(--color-clay-deep)" />
      <rect x="412" y="96" width="16" height="410" rx="4" fill="var(--color-clay-deep)" />
      <rect x="100" y="92" width="340" height="18" rx="6" fill="var(--color-clay-deep)" />
      <rect x="132" y="112" width="276" height="12" rx="6" fill="var(--color-ink-soft)" />
      {warp.map((x) => (
        <line x1={x} y1="124" x2={x} y2="352" stroke="var(--color-paper)" stroke-width="1.6" />
      ))}
      <!-- heddles -->
      <rect x="136" y="214" width="268" height="7" rx="3" fill="var(--color-ink-soft)" opacity="0.8" />
      <rect x="136" y="236" width="268" height="7" rx="3" fill="var(--color-ink-soft)" opacity="0.6" />
      <!-- the woven cloth, with the weave showing through -->
      {rows.map((r) => <rect x="146" y={r.y} width="248" height={r.h} fill={r.c} />)}
      {warp.map((x) => (
        <line x1={x} y1="352" x2={x} y2="456" stroke="var(--color-ink)" stroke-width="1" opacity="0.07" />
      ))}
      <!-- beater bar and cloth beam -->
      <rect x="128" y="340" width="284" height="12" rx="5" fill="var(--color-clay-deep)" />
      <rect x="120" y="456" width="300" height="20" rx="8" fill="var(--color-clay-deep)" />
      <!-- shuttle passing through -->
      <path d="M232 334 Q262 322 300 328 Q322 332 330 334 Q300 342 262 341 Q240 340 232 334z" fill="var(--color-marigold)" />
      <path d="M262 333h40" stroke="var(--color-clay-deep)" stroke-width="2" stroke-linecap="round" />
    </svg>
  </div></div>
  <div class="layer layer-near" data-layer="near"><div data-depth="0.75">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <!-- rail and an indigo shirt on a hanger -->
      <rect x="520" y="300" width="270" height="7" rx="3" fill="var(--color-ink-soft)" />
      <g class="anim-sway" style="transform-origin: 660px 300px">
        <path d="M660 304v-14a10 10 0 1 1 10 -10" fill="none" stroke="var(--color-ink-soft)" stroke-width="4" stroke-linecap="round" />
        <path d="M604 334 L660 306 L716 334" fill="none" stroke="var(--color-ink-soft)" stroke-width="5" stroke-linejoin="round" />
        <path d="M606 330 L640 318 Q660 334 680 318 L714 330 L748 404 L722 414 L708 380 L708 560 L612 560 L612 380 L598 414 L572 404 Z" fill="var(--color-sea-deep)" />
        <path d="M640 318 L660 346 L680 318" fill="none" stroke="var(--color-paper)" stroke-width="3" stroke-linejoin="round" />
        <path d="M660 346V560" stroke="var(--color-sea)" stroke-width="3" />
        {[372, 404, 436, 468, 500].map((y) => <circle cx="666" cy={y} r="3" fill="var(--color-paper)" />)}
        <path d="M630 380h24v20h-24z" fill="none" stroke="var(--color-sea)" stroke-width="2.5" />
      </g>
    </svg>
  </div></div>
  <div class="layer" data-layer="fg"><div data-depth="1.1">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <!-- a spool and its loose thread curling across -->
      <ellipse cx="96" cy="566" rx="46" ry="8" fill="var(--color-ink)" opacity="0.15" />
      <rect x="62" y="488" width="68" height="16" rx="5" fill="var(--color-clay-deep)" />
      <rect x="70" y="502" width="52" height="50" fill="var(--color-clay)" />
      <path d="M70 512h52M70 524h52M70 536h52" stroke="var(--color-clay-deep)" stroke-width="1.5" opacity="0.5" />
      <rect x="62" y="550" width="68" height="16" rx="5" fill="var(--color-clay-deep)" />
      <path d="M122 528 C 200 470, 290 600, 400 552 S 600 500, 820 590" fill="none" stroke="var(--color-clay)" stroke-width="3.5" stroke-linecap="round" />
    </svg>
  </div></div>
</div>
