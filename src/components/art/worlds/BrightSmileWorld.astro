---
/** BrightSmile (dental clinic): calm mint, soft clouds, a friendly tooth, sparkles. */
const sparkles = [
  { x: 540, y: 150, s: 1.2 },
  { x: 250, y: 210, s: 0.8 },
  { x: 600, y: 330, s: 0.7 },
  { x: 170, y: 420, s: 1 },
  { x: 680, y: 480, s: 0.9 },
];
const star = "M0 -24 C 4 -6, 6 -4, 24 0 C 6 4, 4 6, 0 24 C -4 6, -6 4, -24 0 C -6 -4, -4 -6, 0 -24 Z";
const tooth =
  "M300 180C300 120 380 110 400 140 420 110 500 120 500 180 500 260 470 300 460 380 455 420 425 420 420 380L410 320C405 300 395 300 390 320L380 380C375 420 345 420 340 380 330 300 300 260 300 180Z";
const bristles = [0, 1, 2, 3, 4];
---
<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="layer" data-layer="bg"><div data-depth="0.08" class="bs-bg">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <circle cx="400" cy="300" r="250" fill="var(--color-paper)" opacity="0.35" />
      <circle cx="400" cy="300" r="180" fill="var(--color-paper)" opacity="0.35" />
    </svg>
  </div></div>
  <div class="layer layer-far" data-layer="far"><div data-depth="0.22">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <g fill="var(--color-paper)">
        <rect x="60" y="110" width="220" height="44" rx="22" />
        <rect x="110" y="80" width="120" height="50" rx="25" />
        <rect x="520" y="70" width="200" height="40" rx="20" />
        <rect x="570" y="44" width="100" height="44" rx="22" />
      </g>
      <path d="M0 520 C 200 470, 600 470, 800 520 V600 H0Z" fill="var(--color-sea)" opacity="0.35" />
    </svg>
  </div></div>
  <div class="layer layer-mid" data-layer="mid"><div data-depth="0.45">
    <svg class="anim-bob-slow" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <g transform="translate(400 300) scale(1.25) translate(-400 -270)">
        <path d={tooth} fill="var(--color-paper)" />
        <path d="M330 170c4-24 30-30 44-14" stroke="var(--color-mint)" stroke-width="9" stroke-linecap="round" fill="none" />
      </g>
      <path d="M345 300q55 46 110 0" stroke="var(--color-sea)" stroke-width="10" stroke-linecap="round" fill="none" />
      <circle cx="360" cy="252" r="10" fill="var(--color-sea)" />
      <circle cx="440" cy="252" r="10" fill="var(--color-sea)" />
    </svg>
  </div></div>
  <div class="layer layer-near" data-layer="near"><div data-depth="0.75">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      <g transform="rotate(-28 640 470)">
        <rect x="520" y="456" width="300" height="30" rx="15" fill="var(--color-sea)" />
        <rect x="520" y="420" width="90" height="38" rx="6" fill="var(--color-paper)" />
        {bristles.map((i) => <rect x={526 + i * 17} y="420" width="6" height="38" fill="var(--color-mint)" />)}
      </g>
      <path d="M40 620 C 40 520, 90 470, 150 450 C 120 520, 100 570, 60 620Z" fill="var(--color-moss)" />
      <path d="M80 620 C 110 540, 170 510, 230 520 C 180 560, 140 590, 100 620Z" fill="var(--color-moss-deep)" />
    </svg>
  </div></div>
  <div class="layer" data-layer="fg"><div data-depth="1.1">
    <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
      {sparkles.map((s) => <path d={star} transform={`translate(${s.x} ${s.y}) scale(${s.s})`} fill="var(--color-marigold)" />)}
      <circle cx="120" cy="140" r="16" fill="none" stroke="var(--color-paper)" stroke-width="4" />
      <circle cx="700" cy="250" r="11" fill="none" stroke="var(--color-paper)" stroke-width="4" />
    </svg>
  </div></div>
</div>
<style>
  .bs-bg { background: linear-gradient(160deg, var(--color-mint) 0%, var(--color-paper) 120%); }
</style>
