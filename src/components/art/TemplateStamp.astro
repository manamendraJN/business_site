---
/**
 * The red rubber stamp on the grey template site: "Example — A typical
 * business website", so nobody mistakes it for this studio's own site.
 * Positioned over its container (the template, or the hook window, which is
 * the same size), so a sharp copy can sit exactly on top of the blurred one.
 */
import type { HTMLAttributes } from "astro/types";
import { home } from "@/content/site";

type Props = HTMLAttributes<"div">;
const { class: className, ...rest } = Astro.props;
const t = home.hook.template;
---
<div class:list={["tpl-stamp", className]} aria-hidden="true" {...rest}>
  <span class="tpl-stamp-small">{t.stampSmall}</span>
  <span class="tpl-stamp-big">{t.stampBig}</span>
</div>

<style>
  .tpl-stamp {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 78%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.55rem 1.1rem 0.7rem;
    border: 4px double var(--color-clay);
    border-radius: 0.4rem;
    color: var(--color-clay);
    background: color-mix(in srgb, var(--color-dull-50) 82%, transparent);
    font-family: var(--font-display);
    text-transform: uppercase;
    text-align: center;
    transform: translate(-50%, -50%) rotate(-7deg);
    pointer-events: none;
  }
  .tpl-stamp-small {
    font-size: clamp(0.7rem, 1vw, 0.85rem);
    font-weight: 800;
    letter-spacing: 0.35em;
    border-bottom: 2px solid currentColor;
    padding-bottom: 0.15rem;
  }
  .tpl-stamp-big {
    font-size: clamp(1rem, 2.1vw, 1.7rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.05;
  }
  @media (min-width: 640px) {
    .tpl-stamp { left: 62%; top: 44%; }
  }
</style>
