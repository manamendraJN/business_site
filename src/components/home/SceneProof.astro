---
/**
 * SCENE 3 — THE PROOF (short version for Home)
 * Title: "Our work"
 * A list of every project. On computers, hovering a row shows that
 * project's screenshot floating beside the cursor; each row leads to the
 * project's story on the Work page.
 * Ends with the repeated call to action.
 * With motion, this whole section rises over the hero like a new sheet of
 * paper laid on top (scroll-driven; the hero sinks back beneath it).
 */
import { Image } from "astro:assets";
import PopText from "../ui/PopText.astro";
import CtaButton from "../ui/CtaButton.astro";
import TornEdge from "../ui/TornEdge.astro";
import { home, projects, cta } from "@/content/site";

const p = home.proof;
const c = home.proofCta;
const arrow = "M5 12h13M13 6l6 6-6 6";
---
<section data-scene="proof" class="proof relative bg-paper-deep py-section text-ink" aria-labelledby="proof-title">
  <TornEdge color="paper-deep" side="top" seed={13} class="proof-edge absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
  <div class="grid items-end gap-8 px-gutter md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="eyebrow text-clay-deep">{p.eyebrow}</p>
      <h2 id="proof-title" class="mt-4 text-heading"><PopText as="span" text={p.headline} emClass="text-clay-deep" /></h2>
    </div>
    <div class="md:col-span-5">
      <p class="max-w-[38ch] text-lead">{p.intro}</p>
      <a href="/work/" class="link-ink mt-5 inline-flex items-center gap-2 font-bold text-clay-deep">
        {p.more}
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  <!-- Index of every project. On computers, hovering a row shows that
       project's screenshot floating beside the cursor (decorative: the row
       already names the project). -->
  <div class="proof-index mx-gutter mt-14 sm:mt-16" data-proof-index>
    <ul>
      {projects.map((proj, i) => (
        <li>
          <a href={`/work/#${proj.slug}`} class="index-row" data-index-row={i} aria-label={`${p.tileLink}: ${proj.name}`}>
            <span class="index-num serif-em" aria-hidden="true">0{i + 1}</span>
            <span class="index-name font-display text-title">{proj.name}</span>
            <span class="index-kind">{proj.kind}</span>
            <span class="index-tag">{p.conceptLabel}</span>
            <span class="index-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={arrow} stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="index-preview" data-index-preview aria-hidden="true">
      {projects.map((proj, i) => (
        <Image src={proj.screenshot} alt="" widths={[480, 760]} sizes="360px" class="index-shot" data-index-shot={i} loading="lazy" />
      ))}
    </div>
  </div>

  <!-- repeated call to action -->
  <div class="proof-cta mx-gutter mt-section grid items-center gap-8 rounded-paper bg-marigold p-8 text-ink shadow-lift md:grid-cols-12 md:p-12">
    <div class="md:col-span-8">
      <PopText as="h2" text={c.headline} class="text-heading" emClass="text-clay-deep" />
      <p class="mt-4 max-w-[44ch] text-lead">{c.text}</p>
    </div>
    <div class="md:col-span-4 md:justify-self-end">
      <CtaButton href={cta.href} label={c.button} />
    </div>
  </div>
</section>

<style>
  .proof { isolation: isolate; }
  /* With motion: overlap the last screen of the hero and sit above it, so
     scrolling slides this sheet up over the hero. */
  :global(html.motion) .proof { margin-top: -100svh; z-index: 2; }
  :global(.proof-edge) {
    filter: drop-shadow(0 -14px 18px rgb(30 26 21 / 0.35));
    /* keep the shadow above the edge only: without this its blur spills a
       few pixels below the edge and draws a pale line across the sheet */
    clip-path: inset(-80px -40px 0 -40px);
  }
  .proof-cta { transform: rotate(-0.6deg); }

  /* ---- Project index ---- */
  .proof-index ul { border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .proof-index li { border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .index-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    column-gap: 1rem;
    min-height: 4.5rem;
    padding: 1rem 0.25rem;
    transition: padding 0.45s var(--ease-paper), color 0.3s;
  }
  .index-num { color: var(--color-clay-deep); font-size: 1.15rem; }
  .index-name { grid-column: 2; }
  .index-kind { grid-column: 2; font-size: 0.9rem; color: var(--color-ink-soft); }
  .index-tag { display: none; }
  .index-arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-clay-deep);
    transition: background-color 0.3s var(--ease-paper), color 0.3s var(--ease-paper), transform 0.45s var(--ease-paper);
  }
  .index-arrow svg { width: 1.1rem; height: 1.1rem; }
  .index-row:hover { color: var(--color-clay-deep); }
  .index-row:hover .index-arrow { background: var(--color-clay-deep); color: var(--color-paper); transform: rotate(-45deg); }
  .index-row:focus-visible { outline-offset: 2px; }
  @media (min-width: 768px) {
    .index-row { grid-template-columns: 4rem minmax(0, 1.4fr) minmax(0, 1fr) auto auto; column-gap: 1.5rem; min-height: 5.5rem; }
    .index-name, .index-kind { grid-column: auto; }
    .index-kind { font-size: 1rem; }
    .index-tag {
      display: inline-block;
      padding: 0.25rem 0.65rem;
      border: 1.5px dashed currentColor;
      border-radius: 999px;
      color: var(--color-ink-soft);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .index-arrow { grid-column: auto; grid-row: auto; }
    .index-row:hover { padding-left: 1rem; }
  }

  /* the floating preview: computers only; scripts/motion/proof.ts moves it */
  .index-preview { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .index-preview {
      display: block;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 40;
      width: 22rem;
      aspect-ratio: 2 / 1;
      overflow: hidden;
      border: 6px solid var(--color-paper);
      border-radius: var(--radius-paper);
      box-shadow: var(--shadow-lift);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
    }
    .index-preview :global(.index-shot) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      opacity: 0;
      transition: opacity 0.3s var(--ease-paper);
    }
    .index-preview :global(.index-shot.is-on) { opacity: 1; }
  }
</style>
