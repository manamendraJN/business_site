---
/**
 * SCENE 3 — THE PROOF (short version for Home)
 * Title: "Our work"
 * One concept tile per project, each showing a screenshot of the real, live concept
 * site. As each scrolls into view, the site settles into its frame with a
 * gentle zoom. The picture opens the live concept
 * site in a new tab; "See the concept" leads to its story on the Work page.
 * Ends with the repeated call to action.
 * With motion, this whole section rises over the hero like a new sheet of
 * paper laid on top (scroll-driven; the hero sinks back beneath it).
 */
import { Image } from "astro:assets";
import PopText from "../ui/PopText.astro";
import Emphasis from "../ui/Emphasis.astro";
import CtaButton from "../ui/CtaButton.astro";
import TornEdge from "../ui/TornEdge.astro";
import { home, projects, cta } from "@/content/site";

const p = home.proof;
const c = home.proofCta;
const arrow = "M5 12h13M13 6l6 6-6 6";
---
<section data-scene="proof" class="proof relative bg-paper-deep py-section text-ink" aria-labelledby="proof-title">
  <TornEdge color="paper-deep" side="top" seed={13} class="proof-edge absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
  <div class="grid items-end gap-8 px-gutter md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="eyebrow text-clay-deep">{p.eyebrow}</p>
      <h2 id="proof-title" class="mt-4 text-huge"><PopText as="span" text={p.headline} emClass="text-clay-deep" /></h2>
    </div>
    <div class="md:col-span-5">
      <p class="max-w-[38ch] text-lead">{p.intro}</p>
      <a href="/work/" class="link-ink mt-5 inline-flex items-center gap-2 font-bold text-clay-deep">
        {p.more}
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  <!-- two per row on phones and tablets, three on computers; a short last row is centred -->
  <div class="proof-tiles mt-16 flex flex-wrap justify-center gap-x-4 gap-y-10 px-gutter sm:gap-x-6 sm:gap-y-14">
    {projects.map((proj, i) => (
      <article class:list={["proof-tile", i % 2 && "mt-10 lg:mt-0", i % 3 === 1 && "lg:mt-16"]} data-proof-panel>
        <!-- the picture opens the live concept site -->
        <a href={proj.url} target="_blank" rel="noopener" class="shot-link group block" aria-label={`${p.visitLabel}: ${proj.name}, live concept site (opens in a new tab)`}>
          <div class="world-frame" data-world-frame>
            <!-- decorative here: the link already names the project -->
            <Image src={proj.screenshot} alt="" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 31vw, 46vw" class="tile-shot" data-shot />
            <span class="visit-tag">
              {p.visitLabel}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16L17 7M9 7h8v8" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </div>
        </a>
        <span class="concept-badge mt-5 text-ink-soft sm:mt-6">Concept</span>
        <h3 class="mt-3 text-lg leading-tight sm:text-title">{proj.name}</h3>
        <p class="text-xs text-ink-soft sm:text-sm">{proj.kind}</p>
        <p class="mt-2 text-sm font-bold sm:mt-3 sm:text-base"><Emphasis text={proj.after.headline} emClass="text-clay-deep" /></p>
        <!-- the words lead to the full story on the Work page -->
        <a href={`/work/#${proj.slug}`} class="tile-link mt-3 inline-flex items-center gap-2 text-sm font-bold text-clay-deep sm:mt-4" aria-label={`${p.tileLink}: ${proj.name}`}>
          {p.tileLink}
          <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </article>
    ))}
  </div>

  <!-- repeated call to action -->
  <div class="proof-cta mx-gutter mt-section grid items-center gap-8 rounded-paper bg-marigold p-8 text-ink shadow-lift md:grid-cols-12 md:p-12">
    <div class="md:col-span-8">
      <PopText as="h2" text={c.headline} class="text-big" emClass="text-clay-deep" />
      <p class="mt-4 max-w-[44ch] text-lead">{c.text}</p>
    </div>
    <div class="md:col-span-4 md:justify-self-end">
      <CtaButton href={cta.href} label={c.button} />
    </div>
  </div>
</section>

<style>
  .proof { isolation: isolate; }
  /* With motion: overlap the last screen of the hero and sit above it, so
     scrolling slides this sheet up over the hero. */
  :global(html.motion) .proof { margin-top: -100svh; z-index: 2; }
  :global(.proof-edge) {
    filter: drop-shadow(0 -14px 18px rgb(30 26 21 / 0.35));
    /* keep the shadow above the edge only: without this its blur spills a
       few pixels below the edge and draws a pale line across the sheet */
    clip-path: inset(-80px -40px 0 -40px);
  }
  .world-frame {
    position: relative;
    aspect-ratio: 2 / 1; /* the screenshots are about twice as wide as they are tall */
    border: 8px solid var(--color-paper);
    border-radius: var(--radius-paper);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    background: var(--color-paper);
    transition: transform 0.5s var(--ease-paper);
  }
  .group:hover .world-frame { transform: translateY(-8px) rotate(-1deg); }
  .world-frame :global(.tile-shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transform-origin: 50% 0%;
  }
  .shot-link { border-radius: var(--radius-paper); }
  .shot-link:focus-visible { outline-offset: 6px; }
  .tile-link svg { transition: transform 0.3s var(--ease-paper); }
  .tile-link:hover svg { transform: translateX(4px); }
  .tile-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  /* always visible (phones have no hover): this picture is a door to the live site */
  .visit-tag {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--color-clay);
    color: var(--color-paper);
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: var(--shadow-paper);
    transition: background-color 0.25s var(--ease-paper);
  }
  .visit-tag svg { width: 0.95rem; height: 0.95rem; transition: transform 0.3s var(--ease-paper); }
  .group:hover .visit-tag { background: var(--color-clay-deep); }
  .group:hover .visit-tag svg { transform: translate(2px, -2px); }
  .proof-cta { transform: rotate(-0.6deg); }
  .proof-tile { width: calc(50% - 0.5rem); }
  @media (min-width: 640px) { .proof-tile { width: calc(50% - 0.75rem); } }
  @media (min-width: 1024px) { .proof-tile { width: calc(33.333% - 1rem); } }

  /* Phones: two tiles per row, so the frame and its label get smaller */
  @media (max-width: 639px) {
    .world-frame { border-width: 5px; }
    .visit-tag { right: 0.35rem; top: 0.35rem; padding: 0.2rem 0.5rem; gap: 0.2rem; font-size: 0.62rem; }
    .visit-tag svg { width: 0.7rem; height: 0.7rem; }
  }
</style>
