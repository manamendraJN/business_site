---
/**
 * SCENE 5 — THE METHOD (full version, shown on the Services page)
 * Message: "Simple from first call to launch."
 * Five paper notes pinned along a thread. The thread grows as the visitor
 * scrolls and each note folds open, so the process feels like a short,
 * guided walk rather than a project plan.
 */
import PopText from "../ui/PopText.astro";
import TornEdge from "../ui/TornEdge.astro";
import { home, steps, cta } from "@/content/site";

const m = home.method;
const tilts = [-1.6, 1.2, -0.8, 1.6, -1.2];
---
<section id="how-we-work" data-scene="method" class="method relative scroll-mt-16 bg-paper-deep pb-section" aria-labelledby="method-title">
  <TornEdge color="paper-deep" side="top" seed={23} class="absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />

  <div class="grid gap-14 px-gutter pt-section md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="method-intro">
        <p class="eyebrow text-clay-deep">{m.eyebrow}</p>
        <h2 id="method-title" class="mt-3 text-big"><PopText as="span" text={m.headline} emClass="text-clay-deep" /></h2>
        <p class="mt-6 max-w-[34ch] text-lead">{m.sub}</p>
        <a href={cta.href} class="link-ink mt-8 inline-block font-bold">{cta.label} — step 1 is just a chat</a>
      </div>
    </div>

    <ol class="method-steps relative md:col-span-7" data-method-steps>
      <span class="thread-track" aria-hidden="true"></span>
      <span class="thread-fill" data-method-thread aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li class="step" data-step style={`--tilt:${tilts[i % tilts.length]}deg; --shift:${i % 2 ? "2.5rem" : "0rem"}`}>
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <div class="step-note" data-step-note>
            <p class="eyebrow text-clay-deep">Step {i + 1}</p>
            <h3 class="mt-1 text-title">{s.title}</h3>
            <p class="mt-2">{s.text}</p>
            <p class="mt-4 border-t-2 border-dashed border-paper-shade pt-3 text-ink-soft">
              <strong class="text-ink">{m.yourPartLabel}:</strong> {s.yourPart}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method-steps { display: grid; gap: 2.25rem; padding-left: 3.75rem; }
  .thread-track, .thread-fill {
    position: absolute;
    left: 1.2rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 3px;
    border-radius: 3px;
  }
  .thread-track { background: repeating-linear-gradient(180deg, var(--color-paper-shade) 0 8px, transparent 8px 14px); }
  .thread-fill { background: var(--color-clay); transform-origin: 50% 0%; transform: scaleY(0); }
  :global(html:not(.motion)) .thread-fill { transform: none; }

  .step { position: relative; }
  .step-num {
    position: absolute;
    left: -3.75rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 800;
    box-shadow: 0 0 0 5px var(--color-paper-deep);
  }
  .step-note {
    position: relative;
    padding: 1.5rem 1.6rem 1.4rem;
    background: var(--color-paper);
    border-radius: 2px;
    box-shadow: var(--shadow-paper);
    transform: rotate(var(--tilt));
    transform-origin: 50% 0%;
  }
  .step-note::before {
    /* the pin */
    content: "";
    position: absolute;
    top: -0.45rem;
    left: 50%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-clay);
    box-shadow: 0 2px 3px rgb(30 26 21 / 0.3);
  }
  @media (min-width: 768px) {
    .method-intro { position: sticky; top: calc(var(--spacing-header) + 3rem); }
    .step { margin-left: var(--shift); }
    .step-num { left: calc(-3.75rem - var(--shift)); }
    .method-steps { gap: 3rem; }
  }
</style>
