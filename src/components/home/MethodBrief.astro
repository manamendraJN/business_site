---
/**
 * SCENE 5 — THE METHOD (short version for Home)
 * Message: "Simple from first call to launch."
 * The five steps on one line, joined by a thread that grows as the visitor
 * scrolls. The full version (what happens, and "your part" in each step)
 * lives on the Services page, in the "How we work" section.
 * With motion, this section holds still at the end of the page while the
 * footer rises over it (scroll-driven); it sinks back and darkens beneath it.
 */
import PopText from "../ui/PopText.astro";
import { home, steps } from "@/content/site";

const m = home.method;
const arrow = "M5 12h13M13 6l6 6-6 6";
---
<div data-brief-pin class="relative z-[4]">
<section data-scene="method" class="method-brief relative bg-paper-deep py-section" aria-labelledby="method-title" data-brief-sheet>
  <div class="brief-shade" data-brief-shade aria-hidden="true"></div>

  <div class="grid gap-6 px-gutter md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="eyebrow text-clay-deep">{m.eyebrow}</p>
      <h2 id="method-title" class="mt-3 text-big"><PopText as="span" text={m.headline} emClass="text-clay-deep" /></h2>
    </div>
    <div class="self-end md:col-span-5">
      <p class="max-w-[36ch] text-lead">{m.sub}</p>
      <a href="/services/#how-we-work" class="link-ink mt-5 inline-flex items-center gap-2 font-bold text-clay-deep">
        {m.more}
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  <ol class="brief-steps relative mt-14 px-gutter md:mt-20" data-method-brief>
    <span class="brief-track" aria-hidden="true"></span>
    <span class="brief-fill" data-brief-thread aria-hidden="true"></span>
    {steps.map((s, i) => (
      <li class="brief-step" data-brief-step>
        <span class="brief-num" aria-hidden="true">{i + 1}</span>
        <h3 class="text-lg font-extrabold leading-tight tracking-tight">
          <span class="sr-only">Step {i + 1}: </span>{s.title}
        </h3>
      </li>
    ))}
  </ol>
</section>
</div>

<style>
  .brief-shade { display: none; }
  :global(html.motion) .brief-shade {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 5;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }
  .brief-steps { display: grid; gap: 1.5rem; }
  .brief-step { position: relative; display: flex; align-items: center; gap: 1rem; }
  .brief-num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 800;
    box-shadow: 0 0 0 5px var(--color-paper-deep);
  }
  /* the thread: vertical on phones, horizontal from tablets up */
  .brief-track, .brief-fill {
    position: absolute;
    left: calc(var(--spacing-gutter) + 1.375rem - 1.5px);
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    border-radius: 3px;
  }
  .brief-track { background: repeating-linear-gradient(180deg, var(--color-paper-shade) 0 8px, transparent 8px 14px); }
  .brief-fill { background: var(--color-clay); transform-origin: 50% 0%; }
  :global(html.motion) .brief-fill { transform: scaleY(0); }

  @media (min-width: 768px) {
    .brief-steps { grid-template-columns: repeat(5, 1fr); gap: 2rem; }
    .brief-step { flex-direction: column; align-items: flex-start; }
    .brief-track, .brief-fill {
      left: var(--spacing-gutter);
      right: var(--spacing-gutter);
      top: calc(1.375rem - 1.5px);
      bottom: auto;
      width: auto;
      height: 3px;
    }
    .brief-track { background: repeating-linear-gradient(90deg, var(--color-paper-shade) 0 8px, transparent 8px 14px); }
    .brief-fill { transform-origin: 0% 50%; }
    :global(html.motion) .brief-fill { transform: scaleX(0); }
  }
</style>
