---
/**
 * SCENE 4 — THE OFFER (short version for Home)
 * Message: "Four ways to get there."
 * Four paper sheets, one per service, each linking to the full details on
 * the Services page.
 * - Tablets and computers: stacking pages. Each sheet sticks near the top
 *   and the next one rises over it; the covered sheet shrinks and darkens.
 * - Phones: the same stacking, one full-width sheet at a time.
 * - Very short screens (e.g. a phone held sideways): compact cards, two per row.
 */
import PopText from "../ui/PopText.astro";
import ServiceEmblem from "../art/ServiceEmblem.astro";
import { home, services } from "@/content/site";

const o = home.offer;
const sheetStyles = [
  { bg: "var(--color-marigold)", fg: "var(--color-ink)", accent: "var(--color-clay-deep)", tilt: "-1.5deg" },
  { bg: "var(--color-sea)", fg: "var(--color-paper)", accent: "var(--color-marigold)", tilt: "1deg" },
  { bg: "var(--color-clay-deep)", fg: "var(--color-paper)", accent: "var(--color-marigold-soft)", tilt: "-0.6deg" },
  { bg: "var(--color-paper-deep)", fg: "var(--color-ink)", accent: "var(--color-clay-deep)", tilt: "1.6deg" },
];
const arrow = "M5 12h13M13 6l6 6-6 6";
---
<section data-scene="offer" class="offer relative z-[3] bg-paper pb-section" aria-labelledby="offer-title">
  <div class="grid gap-6 px-gutter pt-section md:grid-cols-12">
    <div class="md:col-span-8">
      <p class="eyebrow text-clay-deep">{o.eyebrow}</p>
      <h2 id="offer-title" class="mt-3 text-mega"><PopText as="span" text={o.headline} /></h2>
    </div>
    <div class="self-end md:col-span-4 md:pb-4">
      <p class="max-w-[28ch] text-lead">{o.sub}</p>
      <a href="/services/" class="link-ink mt-5 inline-flex items-center gap-2 font-bold text-clay-deep">
        {o.more}
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  <div class="offer-sheets mt-14 px-gutter md:mt-20">
    {services.map((s, i) => {
      const st = sheetStyles[i % sheetStyles.length];
      return (
        <a
          href={`/services/#${s.slug}`}
          class="offer-sheet"
          data-offer-sheet
          style={`--i:${i}; --sheet-bg:${st.bg}; --sheet-fg:${st.fg}; --sheet-accent:${st.accent}; --tilt:${st.tilt};`}
        >
          <span class="sheet-shade" data-sheet-shade aria-hidden="true"></span>
          <span class="sheet-num serif-em" aria-hidden="true">0{i + 1}</span>
          <ServiceEmblem emblem={s.emblem} class="sheet-emblem" />
          <span class="sheet-text">
            <h3 class="sheet-name">{s.name}</h3>
            <span class="sheet-short">{s.short}</span>
            <span class="sheet-plain">{s.plain}</span>
          </span>
          <span class="sheet-link">
            {o.sheetLink}
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      );
    })}
  </div>
</section>

<style>
  /* ---- Compact cards (phones, short screens) ---- */
  .offer-sheets { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .offer-sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 1.25rem 1rem 1.1rem;
    background: var(--sheet-bg);
    color: var(--sheet-fg);
    border-radius: var(--radius-paper);
    box-shadow: var(--shadow-paper);
    transform: rotate(var(--tilt));
    transition: transform 0.45s var(--ease-paper), box-shadow 0.45s var(--ease-paper);
  }
  .offer-sheet:hover { transform: rotate(0deg) translateY(-10px); box-shadow: var(--shadow-lift); }
  .sheet-shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }
  .sheet-num {
    position: absolute;
    right: 0.5rem;
    top: -0.1em;
    font-size: 3.5rem;
    line-height: 1;
    opacity: 0.16;
    pointer-events: none;
  }
  :global(.sheet-emblem) { width: 3.75rem; height: 3.75rem; flex-shrink: 0; }
  .sheet-text { display: flex; flex-direction: column; }
  .sheet-name {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.15;
  }
  .sheet-short { margin-top: 0.5rem; font-size: 0.875rem; line-height: 1.4; }
  .sheet-plain { display: none; }
  .sheet-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--sheet-accent);
  }
  .sheet-link svg { transition: transform 0.3s var(--ease-paper); }
  .offer-sheet:hover .sheet-link svg { transform: translateX(5px); }

  @media (min-width: 640px) {
    .offer-sheets { gap: 1.25rem; }
    .offer-sheet { padding: 2rem 1.75rem; min-height: 22rem; }
    .sheet-num { right: 1rem; font-size: clamp(5rem, 9vw, 8rem); }
    :global(.sheet-emblem) { width: 6rem; height: 6rem; }
    .sheet-name { margin-top: 1.5rem; font-size: var(--text-title); }
    .sheet-short { margin-top: 0.75rem; font-size: 1rem; line-height: 1.6; }
    .sheet-link { padding-top: 2rem; font-size: 1rem; }
  }

  /* ---- Stacking pages on phones (portrait) ---- */
  @media (max-width: 767px) and (min-height: 560px) {
    .offer-sheets { display: flex; flex-direction: column; gap: 4vh; }
    .offer-sheet {
      position: sticky;
      top: calc(var(--spacing-header) + 0.5rem + var(--i) * 0.8rem);
      min-height: min(22rem, calc(100svh - var(--spacing-header) - 6rem));
      padding: 1.75rem 1.5rem 1.5rem;
      box-shadow: var(--shadow-lift);
      transform: none;
      transform-origin: 50% 0%;
    }
    .offer-sheet:hover { transform: none; }
    .sheet-num { right: 1rem; font-size: 5.5rem; }
    :global(.sheet-emblem) { width: 5rem; height: 5rem; }
    .sheet-name { margin-top: 1.25rem; font-size: var(--text-title); }
    .sheet-short { margin-top: 0.6rem; font-size: 1rem; line-height: 1.5; font-weight: 600; color: var(--sheet-accent); }
    .sheet-link { padding-top: 1.5rem; font-size: 1rem; }
  }

  /* ---- Stacking pages (tablets & computers with enough height) ---- */
  @media (min-width: 768px) and (min-height: 640px) {
    .offer-sheets { display: flex; flex-direction: column; gap: 6vh; }
    .offer-sheet {
      position: sticky;
      top: calc(var(--spacing-header) + 1.25rem + var(--i) * 1.1rem);
      min-height: min(30rem, calc(100svh - var(--spacing-header) - 8rem));
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: clamp(1.5rem, 4vw, 4rem);
      padding: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 5vw, 4.5rem);
      box-shadow: var(--shadow-lift);
      transform: none;
      transform-origin: 50% 0%;
    }
    /* motion drives the transform here; hover only lifts the shadow */
    .offer-sheet:hover { transform: none; }
    .sheet-num { right: 1.5rem; font-size: clamp(7rem, 15vw, 14rem); }
    :global(.sheet-emblem) { width: clamp(8rem, 13vw, 12rem); height: clamp(8rem, 13vw, 12rem); }
    .sheet-name { margin-top: 0; font-size: var(--text-huge); line-height: var(--text-huge--line-height); }
    .sheet-short { margin-top: 1rem; font-size: var(--text-lead); font-weight: 600; color: var(--sheet-accent); }
    .sheet-plain { display: block; margin-top: 0.75rem; max-width: 46ch; }
    .sheet-link { margin-top: 0; padding-top: 0; align-self: end; font-size: 1.05rem; }
  }
</style>
