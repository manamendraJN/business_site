---
/**
 * Page transition: a sheet of paper with torn edges sweeps up over the
 * screen and away again — turning the page. Persisted across navigations.
 */
import TornEdge from "./ui/TornEdge.astro";
---
<div class="page-curtain" data-curtain transition:persist="page-curtain" aria-hidden="true">
  <TornEdge color="clay" side="top" seed={59} class="curtain-edge curtain-edge-top" />
  <div class="curtain-body">
    <svg viewBox="0 0 32 32" class="h-14 w-14" aria-hidden="true">
      <path d="M4 26V8l12-4v18z" fill="var(--color-paper-shade)" />
      <path d="M16 22V4l12 4v18z" fill="var(--color-marigold)" />
      <path d="M4 26l12-4 12 4-12 4z" fill="var(--color-ink)" />
    </svg>
  </div>
  <TornEdge color="clay" side="bottom" seed={61} class="curtain-edge curtain-edge-bottom" />
</div>

<style>
  .page-curtain {
    position: fixed;
    left: 0;
    right: 0;
    top: -6vh;
    height: 112vh;
    z-index: 80;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    transform: translateY(110%);
    opacity: 0;
    will-change: transform;
  }
  .curtain-body {
    flex: 1;
    display: grid;
    place-items: center;
    background: var(--color-clay);
    margin: -1px 0;
  }
</style>
