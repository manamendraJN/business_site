---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PopText from "@/components/ui/PopText.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
import ContactForm from "@/components/pages/ContactForm.astro";
import { meta, contactPage as c, contact } from "@/content/site";
---
<BaseLayout title={meta.contact.title} description={meta.contact.description}>
  <section class="px-gutter pt-[calc(var(--spacing-header)+4rem)] pb-section">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="eyebrow text-clay-deep">{c.eyebrow}</p>
        <PopText as="h1" pop="load" text={c.headline} class="mt-3 text-display" emClass="text-clay-deep" />
      </div>
      <p class="max-w-[34ch] self-end text-lead md:col-span-4">{c.intro}</p>
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <!-- The letter -->
      <div class="letter relative lg:col-span-7">
        <TornEdge color="paper-deep" side="top" seed={151} class="block" />
        <div class="bg-paper-deep px-6 pt-4 pb-10 shadow-lift sm:px-10">
          <ContactForm />
        </div>
      </div>

      <!-- Direct contact + what happens next -->
      <aside class="space-y-10 lg:col-span-5">
        <div class="rotate-[1.5deg] rounded-paper bg-ink p-8 text-paper shadow-lift">
          <h2 class="text-title">{c.directHeadline}</h2>
          <ul class="mt-6 space-y-4 text-lg">
            <li>
              <span class="eyebrow block text-marigold">Email</span>
              <a class="link-ink" href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>
              <span class="eyebrow block text-marigold">Phone</span>
              <a class="link-ink" href={contact.phoneHref}>{contact.phone}</a>
            </li>
            <li>
              <span class="eyebrow block text-marigold">WhatsApp</span>
              <a class="link-ink" href={contact.whatsappHref} target="_blank" rel="noopener">{contact.whatsapp}</a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="text-title">{c.nextHeadline}</h2>
          <ol class="mt-6 space-y-5">
            {c.next.map((n, i) => (
              <li class="flex gap-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-clay font-extrabold text-paper">{i + 1}</span>
                <span class="pt-2">{n}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
