---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PopText from "@/components/ui/PopText.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
import { meta, aboutPage as a, business, cta } from "@/content/site";

const noteTones = ["bg-marigold", "bg-mint", "bg-blush", "bg-paper"];
const tilts = ["-rotate-3", "rotate-2", "rotate-[-1deg]", "rotate-3"];
---
<BaseLayout title={meta.about.title} description={meta.about.description}>
  <!-- Hero: who we are -->
  <section class="relative overflow-hidden px-gutter pt-[calc(var(--spacing-header)+3rem)] pb-section">
    <p class="eyebrow text-clay-deep">{a.eyebrow}</p>
    <PopText as="h1" pop="load" text={a.headline} class="mt-3 text-display" emClass="text-clay-deep" />
    <p class="mt-6 max-w-[30ch] font-display text-title">{a.lead}</p>
  </section>

  <!-- Story -->
  <section class="relative bg-paper-deep px-gutter py-section">
    <TornEdge color="paper-deep" side="top" seed={131} class="absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
    <div class="grid gap-12 md:grid-cols-12">
      <div class="space-y-6 text-lead md:col-span-6 md:col-start-2">
        {a.story.map((para) => <p data-reveal>{para}</p>)}
      </div>
      <p class="md:col-span-4 md:col-start-9 text-ink-soft" data-reveal>
        <span class="eyebrow block text-clay-deep">{a.basedLabel}</span>
        <span class="mt-2 block font-display text-title text-ink">{business.location}</span>
      </p>
    </div>
  </section>

  <!-- Beliefs: four notes pinned to the board -->
  <section class="relative bg-sea-deep px-gutter py-section text-paper">
    <TornEdge color="sea-deep" side="top" seed={137} class="absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
    <PopText as="h2" text={a.beliefsHeadline} class="text-heading" />
    <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {a.beliefs.map((b, i) => (
        <li class={`belief relative p-7 pt-9 text-ink shadow-lift ${noteTones[i % 4]} ${tilts[i % 4]} ${i % 2 ? "lg:mt-16" : ""}`} data-reveal>
          <span class="pin" aria-hidden="true"></span>
          <h3 class="text-title">{b.title}</h3>
          <p class="mt-3">{b.text}</p>
        </li>
      ))}
    </ul>
    <!-- what to do next -->
    <div class="mt-20 flex flex-wrap items-center gap-6">
      <CtaButton href={cta.href} label={cta.label} />
      <a href="/work/" class="link-ink font-bold text-paper">See the concept projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .pin {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-clay);
    box-shadow: 0 2px 3px rgb(30 26 21 / 0.35);
  }
</style>
