---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TemplateMini from "@/components/art/TemplateMini.astro";
import PopText from "@/components/ui/PopText.astro";
import Emphasis from "@/components/ui/Emphasis.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
import { meta, workPage as w, projects, projectsNote, cta, home } from "@/content/site";

const bands = {
  kopi: { token: "clay-deep", bg: "bg-clay-deep", fg: "text-paper", accent: "text-marigold-soft" },
  petal: { token: "blush", bg: "bg-blush", fg: "text-ink", accent: "text-ink-soft" },
  loom: { token: "paper-shade", bg: "bg-paper-shade", fg: "text-ink", accent: "text-clay-deep" },
} as const;
// three prints: two on top, one below in the middle (offsets are in print
// widths and heights, so the pile scales with the screen)
const fan = [
  "rotate-[-6deg] translate-x-[0%] translate-y-[0%]",
  "rotate-[5deg] translate-x-[80%] translate-y-[8%]",
  "rotate-[-3deg] translate-x-[40%] translate-y-[112%]",
];
---
<BaseLayout title={meta.work.title} description={meta.work.description}>
  <!-- Hero: prints of the real concept sites fanned out on the table -->
  <section class="relative grid gap-12 overflow-hidden px-gutter pt-[calc(var(--spacing-header)+4rem)] pb-section md:grid-cols-12">
    <div class="relative z-10 md:col-span-6">
      <p class="eyebrow text-clay-deep">{w.eyebrow}</p>
      <PopText as="h1" pop="load" text={w.headline} class="mt-3 text-huge" emClass="text-clay-deep" />
      <p class="mt-8 max-w-[40ch] text-lead">{w.intro}</p>
    </div>
    <div class="relative min-h-[17rem] md:col-span-6 md:min-h-[30rem]" data-parallax-root>
      {projects.map((p, i) => (
        <a href={`#${p.slug}`} class={`print absolute left-0 top-0 w-[55%] ${fan[i]}`} aria-label={`Jump to ${p.name}`}>
          <span class="block" data-depth={String(0.2 + i * 0.18)}>
            <span class="print-frame relative block aspect-[2/1] overflow-hidden border-[8px] border-paper shadow-lift">
              <Image src={p.screenshot} alt="" widths={[400, 640, 900]} sizes="(min-width: 768px) 24vw, 46vw" class="absolute inset-0 h-full w-full object-cover object-top" loading="eager" />
            </span>
            <span class="mt-2 block truncate font-bold text-sm">{p.name}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {projects.map((p, i) => {
    const b = bands[p.world];
    return (
      <section id={p.slug} class={`relative ${b.bg} ${b.fg} scroll-mt-16`} aria-labelledby={`${p.slug}-title`}>
        <TornEdge color={b.token} side="top" seed={70 + i} class="absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
        <div class="px-gutter py-section">
          <div class="grid items-end gap-10 md:grid-cols-12">
            <div class:list={["md:col-span-5", i % 2 && "md:order-2"]}>
              <span class="concept-badge">Concept project</span>
              <p class="eyebrow mt-6 opacity-80">0{i + 1} · {p.kind}</p>
              <h2 id={`${p.slug}-title`} class="mt-2 text-huge">{p.name}</h2>
              <p class="mt-5 text-title font-bold"><Emphasis text={p.after.headline} /></p>
              <a href={p.url} target="_blank" rel="noopener" class="visit mt-8">
                {w.visitLabel}
                <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d="M8 16L17 7M9 7h8v8" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
            <div class:list={["md:col-span-7", i % 2 && "md:order-1"]}>
              <div class="relative pl-6 pb-6 md:pl-12 md:pb-10">
              <!-- the real concept site: the picture opens it in a new tab -->
              <a href={p.url} target="_blank" rel="noopener" class="shot group relative block aspect-[2/1] overflow-hidden rounded-paper border-[10px] border-paper shadow-lift" aria-label={`${w.visitLabel}: ${p.name}, live concept site (opens in a new tab)`}>
                <Image src={p.screenshot} alt="" widths={[640, 960, p.screenshot.width]} sizes="(min-width: 768px) 55vw, 92vw" class="absolute inset-0 h-full w-full object-cover object-top" />
                <span class="visit-tag">
                  {home.proof.visitLabel}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16L17 7M9 7h8v8" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
              <!-- the plain "before" site, tucked under the bottom-left corner -->
              <TemplateMini class="before-card pointer-events-none absolute bottom-0 left-0 w-[30%] max-w-[11rem] -rotate-6" title={p.before.title} text={p.before.text} label={home.proof.beforeLabel} />
              </div>
              <p class="mt-4 text-sm opacity-80">{w.screenshotLabel}: <a href={p.url} target="_blank" rel="noopener" class="underline underline-offset-2">{new URL(p.url).host}</a>. {projectsNote}</p>
            </div>
          </div>

          <div class="mt-16 grid gap-10 md:grid-cols-3" data-reveal>
            <div>
              <p class={`eyebrow ${b.accent}`}>{w.problemLabel}</p>
              <p class="mt-3">{p.plainProblem}</p>
            </div>
            <div>
              <p class={`eyebrow ${b.accent}`}>{w.storyLabel}</p>
              <p class="mt-3">{p.story}</p>
            </div>
            <div>
              <p class={`eyebrow ${b.accent}`}>{w.momentsLabel}</p>
              <ol class="mt-3 space-y-2">
                {p.moments.map((m, j) => (
                  <li class="flex gap-3"><span class="serif-em text-xl leading-6">{j + 1}</span><span>{m}</span></li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- The empty slot: your business could be next -->
  <section class="relative bg-paper px-gutter py-section">
    <TornEdge color="paper" side="top" seed={88} class="absolute inset-x-0 -top-[clamp(17px,2.9vw,39px)]" />
    <div class="grid items-center gap-12 md:grid-cols-12">
      <div class="placeholder-box aspect-[4/3] rotate-2 rounded-paper p-8 md:col-span-5">
        <p class="text-title font-extrabold">Your business here</p>
      </div>
      <div class="md:col-span-7">
        <PopText as="h2" text={w.nextHeadline} class="text-huge" emClass="text-clay-deep" />
        <p class="mt-6 max-w-[36ch] text-lead">{w.nextText}</p>
        <CtaButton href={cta.href} label={cta.label} class="mt-9" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .print:hover { z-index: 5; }
  .print-frame { transition: transform 0.5s var(--ease-paper); }
  .print:hover .print-frame { transform: translateY(-10px) rotate(-1deg); }
  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.4rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 700;
    box-shadow: var(--shadow-paper);
    transition: transform 0.3s var(--ease-paper), box-shadow 0.3s var(--ease-paper);
  }
  .visit:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .visit svg { transition: transform 0.3s var(--ease-paper); }
  .visit:hover svg { transform: translate(2px, -2px); }
  .shot { transition: transform 0.5s var(--ease-paper), box-shadow 0.5s var(--ease-paper); }
  .shot:hover { transform: translateY(-6px) rotate(-0.5deg); }
  .shot:focus-visible { outline-offset: 6px; }
  /* always visible (phones have no hover): the picture is a door to the live site */
  .visit-tag {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--color-clay);
    color: var(--color-paper);
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: var(--shadow-paper);
    transition: background-color 0.25s var(--ease-paper);
  }
  .visit-tag svg { width: 1rem; height: 1rem; transition: transform 0.3s var(--ease-paper); }
  .shot:hover .visit-tag { background: var(--color-clay-deep); }
  .shot:hover .visit-tag svg { transform: translate(2px, -2px); }
  @media (max-width: 639px) {
    /* a smaller, simpler "before" card so it stays in its corner */
    :global(.before-card) { width: 38%; }
    :global(.before-card > div:last-child) { padding: 0.35rem 0.4rem 0.45rem; }
    :global(.before-card p) { font-size: 0.6rem; line-height: 1.2; }
    :global(.before-card p + p),
    :global(.before-card span.inline-block) { display: none; }
    :global(.before-card [class*="aspect-"]) { margin-bottom: 0.3rem; }
    .visit-tag { right: 0.4rem; top: 0.4rem; padding: 0.25rem 0.6rem; font-size: 0.72rem; }
    .visit-tag svg { width: 0.8rem; height: 0.8rem; }
  }
</style>
